APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# URL of the React SPA. In production this MUST be the exact scheme+host of the
# built frontend (no trailing slash) — it feeds CORS allowed_origins.
# Prod example: https://app.transaction.gethomehub.ca
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Local dev: leave null. Production (SPA + API on sibling subdomains): set to the
# shared parent domain WITH a leading dot so the cookie is sent across subdomains.
# Prod example: SESSION_DOMAIN=.gethomehub.ca
SESSION_DOMAIN=null
# "lax" is correct when the SPA and API share a registrable domain (same-site).
SESSION_SAME_SITE=lax
# MUST be true when served over HTTPS (production), false on plain HTTP (local).
SESSION_SECURE_COOKIE=false

# --- Sanctum SPA (cookie) authentication ---
# Comma-separated hosts (no scheme, no path) allowed to receive a stateful
# session cookie. Include the React SPA host in production.
# Prod example: SANCTUM_STATEFUL_DOMAINS=app.transaction.gethomehub.ca
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# FINTRAC ID auto-extraction (Form 630)
ID_EXTRACTION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ID_EXTRACTION_MODEL=claude-sonnet-5
