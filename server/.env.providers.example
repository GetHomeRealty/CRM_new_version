# Server-only non-production provider overlay. Not automatically loaded.
# Copy outside source control or to an ignored .env.providers.local and keep permissions 0600.
# Existing production .env and local transport sandbox must not be overwritten/bypassed.
# Values below remain unconfigured; obtain them from the actual test provider accounts.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gh_mobile_test
NODE_ENV=test
APP_KEY=
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GOOGLE_PUBLIC_URL=
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_PUBLIC_URL=
META_OAUTH_STRATEGY=hybrid
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=
META_SYNC_DISABLED=true
EXPO_PUSH_ACCESS_TOKEN=
NATIVE_PUSH_ENABLED=false
PROVIDER_SENT_ENABLED=false
# SMTP/IMAP mailbox host, username and secret are configured through the existing owned-mailbox UI,
# encrypted in the local test database; they are not substituted with invented env variables.
# NODE_ENV=test deliberately prevents live provider transports. This file is preparation, not live acceptance.

# Private client review response-page origin; dedicated test HTTPS origin when testing externally.
# Loopback HTTP is accepted only with NODE_ENV=test. Never rotate existing APP_KEY for this.
CLIENT_REVIEWS_PUBLIC_URL=
CLIENT_REVIEWS_EMAIL_ENABLED=false

# Mobile Desk reminder sends require explicit opt-in after provider/device acceptance.
DESK_DOCUMENT_REMINDERS_ENABLED=false

# Native invoice delivery remains off until dedicated-provider acceptance.
DESK_INVOICE_EMAIL_ENABLED=false
