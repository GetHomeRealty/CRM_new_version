{
  "compilerOptions": {
    // nodenext, not commonjs/node10. package.json sets "type": "commonjs", so the emitted
    // JavaScript is unchanged — every file still compiles to require()/exports. What changes is
    // resolution: node10 predates package.json "exports" and "type", so it could not read modern
    // export maps and had no notion of a module's format. nodenext models the Node we actually
    // run on, including require() of an ESM package (archiver v8) — legal since Node 20.19.
    "module": "nodenext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "nodenext",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    // Pinned, not inferred. Without it TypeScript derives the root from the longest common
    // directory of the inputs, so adding one .ts file outside src/ would silently move every
    // output to dist/src/... and break `start:prod` (node dist/main.js) with no error.
    "rootDir": "./src",
    "incremental": true,
    /*
     * The incremental cache lives INSIDE dist/, so it dies with it.
     *
     * nest-cli.json sets `deleteOutDir: true`, so every `nest build` and every `nest start` wipes
     * dist/ first. With the default cache location (./tsconfig.build.tsbuildinfo, beside this file)
     * the cache SURVIVED that wipe — TypeScript then read it, concluded every file was already up
     * to date, emitted nothing, and exited 0. The result is an empty dist/ from a command that
     * reported success, and `Cannot find module dist/main` from the next `npm start`.
     *
     * `build-guard.cjs` already catches this for `npm run build` by deleting the cache first, but
     * it cannot cover `nest start`, `nest start --watch`, or anyone invoking the compiler directly
     * — and those are the commands a developer runs all day. Putting the cache under the directory
     * that gets deleted makes the two consistent by construction: if the output is gone, the
     * record of having produced it is gone too, so the compiler always rebuilds what is missing.
     */
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "skipLibCheck": true,
    "resolveJsonModule": true,

    // Strictness required by the migration spec.
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // class-validator/Nest DTO fields are populated by the framework, not in a
    // constructor, so property-init checking is disabled (standard for Nest).
    "strictPropertyInitialization": false
  },
  // Specs live beside the code they cover (src/**/*.spec.ts); there is no test/ directory.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
