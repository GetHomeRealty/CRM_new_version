{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    // Pinned, not inferred. Without it TypeScript derives the root from the longest common
    // directory of the inputs, so adding one .ts file outside src/ would silently move every
    // output to dist/src/... and break `start:prod` (node dist/main.js) with no error.
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    // Strictness required by the migration spec.
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // class-validator/Nest DTO fields are populated by the framework, not in a
    // constructor, so property-init checking is disabled (standard for Nest).
    "strictPropertyInitialization": false
  },
  // Specs live beside the code they cover (src/**/*.spec.ts); there is no test/ directory.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
