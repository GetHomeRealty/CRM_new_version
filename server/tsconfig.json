{
  "compilerOptions": {
    // nodenext, not commonjs/node10. package.json sets "type": "commonjs", so the emitted
    // JavaScript is unchanged — every file still compiles to require()/exports. What changes is
    // resolution: node10 predates package.json "exports" and "type", so it could not read modern
    // export maps and had no notion of a module's format. nodenext models the Node we actually
    // run on, including require() of an ESM package (archiver v8) — legal since Node 20.19.
    "module": "nodenext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "nodenext",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    // Pinned, not inferred. Without it TypeScript derives the root from the longest common
    // directory of the inputs, so adding one .ts file outside src/ would silently move every
    // output to dist/src/... and break `start:prod` (node dist/main.js) with no error.
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    // Strictness required by the migration spec.
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // class-validator/Nest DTO fields are populated by the framework, not in a
    // constructor, so property-init checking is disabled (standard for Nest).
    "strictPropertyInitialization": false
  },
  // Specs live beside the code they cover (src/**/*.spec.ts); there is no test/ directory.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
