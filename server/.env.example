# ── Transaction Desk API (NestJS) ─────────────────────────────────────────────
# Behaviour-preserving port of the Laravel 12 backend. Values mirror the Laravel
# .env so auth/CORS/cookies behave identically to the frontend.

NODE_ENV=development
PORT=8000

# Server timezone. Not cosmetic: Inventory's "today", the calendar's all-day event
# dates and Meta's week-start figure are all derived from the server's LOCAL clock.
# A Linux host defaults to UTC, where 10:30pm in Toronto is already tomorrow — so
# anything entered in the evening would be recorded a day late. The brokerage is in
# Ontario, so this is Toronto. Required in production; the server will not start
# without it.
TZ=America/Toronto

# PostgreSQL — the NEW datastore for this backend (Prisma `postgresql` provider).
# Provision a Postgres instance and point this at it before running migrations.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/myapp?schema=public"

# MySQL — the EXISTING Laravel datastore. Used only for schema introspection
# (`prisma db pull`) and the one-time MySQL→Postgres data ETL.
MYSQL_URL="mysql://root@127.0.0.1:3306/myapp"

# Session / cookie auth (emulates Laravel Sanctum SPA contract).
SESSION_SECRET="change-me-to-a-long-random-string"
SESSION_COOKIE_NAME=laravel_session
SESSION_LIFETIME_MINUTES=120
# Local HTTP → false, lax.
#
# Production is deployed SINGLE-ORIGIN — the SPA and the API answer on the same host, with the
# API reached at /api through the reverse proxy. That makes the session cookie same-site by
# construction: COOKIE_DOMAIN stays EMPTY (a host-only cookie) and SameSite=lax is correct.
# See the production block at the end of this file.
#
# Only set COOKIE_DOMAIN if the SPA and API are ever split across subdomains, and then it must
# carry the leading dot (".gethomehub.ca") or the other subdomain never receives the cookie.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS — the React SPA origin(s), comma-separated. Must allow credentials.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded files live: documents, FINTRAC identification, the brand logo, user
# photos, generated exports and the recycle bin.
#
# Leave blank and it resolves to "<working directory>/../storage/app", which is the
# historical behaviour and correct when the process is started from the server/ folder.
# That dependency on the working directory is the hazard: start the service under
# systemd, pm2 or Docker with a different WorkingDirectory and every path silently
# moves — uploads go somewhere new and existing documents resolve to files that are
# not there, with nothing reporting it.
#
# Setting an ABSOLUTE path here removes the dependency entirely. Recommended in
# production. In production the server refuses to start if the directory is missing,
# rather than creating an empty one and appearing to work.
STORAGE_ROOT=

# Password hashing — matches Laravel BCRYPT_ROUNDS.
BCRYPT_ROUNDS=12

# Background schedulers: the IMAP poller, the export sweeper, and the lawyer-detail
# reminders. They are in-process timers, not distributed jobs, so EVERY process that
# runs them runs them — two instances means two IMAP syncs racing on one mailbox and
# two copies of every reminder email reaching a real client.
#
# Leave unset (or true) on the one instance that should own them. This deployment runs
# a single instance anyway: uploads are written to local disk, so it cannot meaningfully
# scale out. If a second process is ever added — pm2 cluster mode, another container —
# start it with RUN_SCHEDULERS=false and keep exactly one owner.
#
# A non-owner still serves every route normally, and exports queued on it still run;
# only the table-wide reclaim and the timers are skipped.
RUN_SCHEDULERS=true

# --- Rate limits ----------------------------------------------------------
#
# All optional; the defaults shown are what the code uses when these are unset. Every value is
# read at startup, so tuning them needs a restart but not a rebuild.
#
# The general bucket is keyed by SIGNED-IN USER, not by IP. That distinction is the whole point:
# a brokerage office shares one NAT address, so an IP-keyed bucket is really an office bucket
# whose ceiling depends on how many colleagues happen to be working. Measured, one agent editing
# a transaction generates about 50 requests a minute (the detail screen auto-saves on a 1.2 s
# debounce), so ~12 people in one office used to exhaust a 600/minute IP bucket on that one
# endpoint and their saves began failing mid-edit. Below is therefore what ONE PERSON may do.
#
# It is also PER ENDPOINT — the throttler hashes the handler name into its key — so this is 600
# on each route independently, not 600 across everything. It is a runaway guard for the busiest
# single endpoint, not an overall budget.
#RATE_LIMIT_PER_MINUTE=600
#
# Anonymous traffic — everything before sign-in — has no user to key on, so it is keyed by IP and
# a whole office genuinely does share it. Kept larger than the per-user limit for that reason.
#RATE_LIMIT_ANON_PER_MINUTE=1200
#
# Sign-in, registration and password change, per IP. Sized for a whole office arriving at 9 a.m.
# Raising this does NOT weaken brute-force protection, because that job belongs to the per-account
# limit below, which an attacker cannot escape by changing address.
#AUTH_RATE_LIMIT_MAX=120
#AUTH_RATE_LIMIT_WINDOW_SECONDS=300
#
# Failed sign-ins for ONE ACCOUNT, counted regardless of source address. This is the real
# brute-force defence. Only FAILURES count and a correct password clears the record, so somebody
# who mistypes twice and then succeeds is never affected.
#AUTH_ACCOUNT_LIMIT_MAX=8
#AUTH_ACCOUNT_LIMIT_WINDOW_SECONDS=900

# --- Inbound mail retention ----------------------------------------------
#
# The mirrored mailbox is the largest thing in this database by a wide margin — 77 MB of an 80 MB
# database when last measured, having doubled in a week — and it grows with mail volume rather
# than with brokerage activity. Backup size, dump time and restore time all track it.
#
# 0 (the default) keeps everything forever, which is the current behaviour and changes nothing on
# upgrade. Set a number of days to have the nightly sweep remove older messages. CHOOSE THIS
# AGAINST YOUR OWN RETENTION AND COMPLIANCE OBLIGATIONS, not for disk space — messages attached to
# a lead or transaction may be part of the record of a deal.
#
# Messages linked to a lead are never removed regardless of age unless you opt in below.
#MAIL_RETENTION_DAYS=0
#MAIL_RETENTION_INCLUDE_LINKED=false
#
# Bodies are the bulk of the size. Stripping them keeps the message, its sender, subject, date and
# snippet — enough to see that a conversation happened and search for it — while discarding the
# HTML that makes up most of the bytes. A gentler first step than deletion.
#MAIL_STRIP_BODIES_AFTER_DAYS=0

# How many mailboxes the IMAP poller syncs at once. Default 4.
#
# THE ARITHMETIC, because the default silently stops being enough as a brokerage grows. The poller
# runs every IMAP_POLL_INTERVAL and works through the connected accounts this many at a time. If a
# full cycle takes longer than the interval, passes overlap: mail arrives late, by an amount that
# grows with the backlog rather than settling. At the measured per-mailbox sync time, 500 mailboxes
# need roughly 17 in flight to finish a cycle inside a 60-second interval — a load audit measured
# the default overrunning by 2–6x at that size.
#
# Raise this OR lengthen the interval; both fix the overrun. What you cannot do is leave it at 4 and
# add mailboxes indefinitely. The ceiling is your mail provider's simultaneous-connection limit —
# exceeding it gets connections refused, so check the provider before going much above this.
#IMAP_POLL_CONCURRENCY=4

# FINTRAC ID auto-extraction (Form 630).
#
# WHAT IT DOES: uploads the COMPLETE IMAGE OR PDF of a client's passport or driver's licence to
# Anthropic to read the fields off it. Not extracted text — the document, including the photograph,
# the document number, the date of birth and the home address. It is the most sensitive disclosure
# this application makes. See docs/AI-PRIVACY-REVIEW.md section 3.
#
# DISABLED BY DEFAULT, and this is the only thing that disables it today. It has no consent switch
# yet (BACKLOG B-3) and NO KEY OF ITS OWN: `apiKey` below resolves to ANTHROPIC_API_KEY, the same
# variable the lead-email and calendar AI features read. So setting an Anthropic key to enable those
# — both of which are now gated and audited, so you reasonably might — would silently switch this
# one back on. The guard is `provider !== 'anthropic' || !key`, so any other value stops it before
# the network call and the form falls back to manual entry, which is the behaviour it is designed
# to degrade to.
#
# Change this to `anthropic` only once B-3 is done and the brokerage has decided that sending
# identity documents to a processor is covered by what clients are told when their ID is collected.
ID_EXTRACTION_PROVIDER=disabled
# Shared with the other AI features — see AI_EMAIL_DRAFTING below. Not a per-feature key.
ANTHROPIC_API_KEY=
ID_EXTRACTION_MODEL=claude-sonnet-5

# --- Meta (Facebook / Instagram) lead ads ---------------------------------
# From the Meta app dashboard. Without these the Meta screen stays read-only and
# reports itself as unconfigured; nothing else in the app is affected.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration id. Business-type apps reject the OAuth
# dialog without it ("This app needs at least one supported permission").
META_LOGIN_CONFIG_ID=
# Public HTTPS origin of THIS API. Meta rejects a non-HTTPS redirect URI, so a local
# server needs a tunnel. The value below must appear verbatim in the Meta app's
# "Valid OAuth Redirect URIs", with /api/meta/callback appended.
META_PUBLIC_URL=
# scope | config | hybrid — leave as config unless the app is a legacy consumer app.
META_OAUTH_STRATEGY=config
# Only for System-user token configurations; wrong on a User access token config.
META_OAUTH_SYSTEM_USER=false
META_GRAPH_API_VERSION=v21.0
# Webhook: the verify token is the string you enter in Meta's subscription form. The
# secret signs each delivery; it falls back to META_APP_SECRET when blank.
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_SECRET=
# Auto-sync. Meta's webhook is the fast path; this polls as a backstop, because the
# webhook only works while META_PUBLIC_URL is publicly reachable and the subscription
# is live — an expired tunnel or a redeploy stops deliveries with no symptom except
# leads that never arrive. Both paths converge on the same upsert, so a lead already
# delivered by webhook is recognised, not duplicated.
# Seconds between passes; 900 (15 min) by default, floor of 60. Graph rate limits are
# per app, so do not set this aggressively low with several connected accounts.
META_SYNC_SECONDS=900
# Set to 1 to switch auto-sync off entirely and rely on the webhook plus "Sync now".
META_SYNC_DISABLED=

# Diverts every outgoing email to one address. Set this before running any
# verification script that sends — the mail accounts in a seeded database are real.
MAIL_REDIRECT_TO=

# --- Campaign open tracking -----------------------------------------------
# Public HTTPS origin of THIS API, baked into the tracking pixel and unsubscribe
# link of every campaign email. It must be reachable from a recipient's mail
# client, so localhost and LAN addresses do not work — the Campaigns screen
# actively fetches the pixel through this address and reports what it finds.
# Leave blank while developing locally: sends, bounces, failures and unsubscribes
# are still recorded; only the open count stays at zero.
# Emails already sent keep whatever URL they were built with.
CAMPAIGN_PUBLIC_URL=

# --- Meta OAuth / Lead Ads (aliases accepted for CRM parity) --------------
# Either naming works; META_* wins when both are set.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_WEBHOOK_SECRET=
# Exact value on Meta's "Valid OAuth Redirect URIs" list. Leave blank to derive it as
# <public base>/api/meta/callback.
FACEBOOK_REDIRECT_URI=
# Public origin of the app; used when FACEBOOK_REDIRECT_URI is blank.
NEXT_PUBLIC_APP_URL=
NEXTAUTH_URL=

# --- Twilio SMS gateway ---------------------------------------------------
# Leave every value blank and SMS falls back to the device: "Send SMS" opens the
# phone's messaging app through an sms: link and the delivery status is set by
# hand. Fill these in and the server sends the message itself, and Queued / Sent
# / Delivered / Failed arrive on their own from Twilio's status callback.
#
# NOTE: "Read" is never reported for plain SMS by any provider — the protocol has
# no read receipt — so it stays a manual mark either way.
#
# From the Twilio Console dashboard. The auth token signs every webhook, so
# treat it exactly like a password: it must never reach the browser.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number messages go out from, in E.164 (e.g. +14165550134).
TWILIO_FROM_NUMBER=
# Optional. A Messaging Service (MG…) instead of a single number: Twilio then
# picks the sender and handles STOP/START opt-outs for you. Wins over the number.
TWILIO_MESSAGING_SERVICE_SID=
# Public HTTPS origin of THIS API, reachable from Twilio. Needed for two things:
#   1. telling Twilio where to report delivery status, and
#   2. rebuilding the exact URL its signature was computed over.
# Behind a proxy the host this process sees is not the host Twilio requested, and
# a mismatch fails every signature check with no obvious cause — so set it.
# Blank: messages still send, but their status never updates past what the API
# returned, and both webhooks reject everything.
#
# In the Twilio Console, point the number at:
#   status callback  ->  <TWILIO_PUBLIC_URL>/api/sms/twilio/status
#   incoming message ->  <TWILIO_PUBLIC_URL>/api/sms/twilio/inbound
TWILIO_PUBLIC_URL=

# --- Google Calendar OAuth (real "Sign in with Google") ------------------
# Leave blank and the Connect Google Calendar button explains it is not set up.
# Fill these in and clicking Connect sends the user to Google's own account
# picker / consent screen, then two-way syncs their calendar.
#
# From Google Cloud Console (console.cloud.google.com):
#   1. Create a project, enable the "Google Calendar API".
#   2. Configure the OAuth consent screen; add the scope
#        https://www.googleapis.com/auth/calendar.events
#      (a sensitive scope — works for your test users immediately; needs
#       Google verification before every user can use it).
#   3. Create an OAuth 2.0 Client ID (type: Web application) and register the
#      redirect URI below under "Authorised redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact redirect URI registered in the Cloud console. Leave blank to derive it
# as <public base>/api/google/callback.
GOOGLE_REDIRECT_URI=
# Public origin of THIS API, used when GOOGLE_REDIRECT_URI is blank.
GOOGLE_PUBLIC_URL=

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION — single origin
#
# The SPA and the API are served from ONE host (https://gethomehub.ca): the built
# client at /, and the API proxied at /api. Two reasons this shape and not a
# separate api.* subdomain:
#
#   1. The OAuth redirect URIs and webhooks already registered with Google, Meta
#      and Twilio point at https://gethomehub.ca/api/... — moving the API to
#      another host means re-registering every one of them, and any that is
#      missed breaks only in production, only for that integration.
#   2. The session cookie becomes same-site by construction. No COOKIE_DOMAIN, no
#      SameSite=None, no cross-site CORS — which is the whole class of faults that
#      shows up as "login succeeds then bounces straight back".
#
# The server does not start in production until these are right; it prints what
# is wrong and exits (see src/config/validate-config.ts).
#
#   NODE_ENV=production
#   PORT=8000                       # bound to localhost; nginx terminates TLS
#   RUN_SCHEDULERS=true             # exactly ONE process may have this on
#
#   # Absolute, so it does not depend on where the service is started from. Must be
#   # the directory already holding the files, and on persistent storage — not a
#   # container layer that is discarded on redeploy.
#   STORAGE_ROOT=/srv/transaction-desk/storage/app
#
# Deploying, in order:
#
#   pg_dump "$DATABASE_URL" > backup-$(date +%F-%H%M).sql   # before anything else
#   npm ci
#   npm run prisma:generate
#   npm run prisma:status      # what is pending — read-only, safe to run anytime
#   npm run prisma:deploy      # apply them; forward-only, cannot reset
#   npm run build
#   npm run start:prod         # or restart the service
#
# NEVER `prisma migrate dev` against this database. It resets the database when it
# finds drift, and a production database picks up drift easily — a hand-applied fix,
# a restored backup. `npm run prisma:migrate` is guarded and will refuse to run
# against anything that is not a local database, but the habit is the real safeguard.
#
#   # Carry the EXISTING key forward. It decrypts the IMAP passwords and Google
#   # refresh tokens already in the database — a new one makes them unreadable and
#   # every mail/calendar integration must be reconnected by hand.
#   APP_KEY=base64:<the key already in use>
#   SESSION_SECRET=<openssl rand -base64 48>
#
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=lax
#   COOKIE_DOMAIN=                  # EMPTY — single origin needs no domain scope
#
#   FRONTEND_URL=https://gethomehub.ca
#   CORS_ORIGINS=https://gethomehub.ca      # no trailing slash
#
# And on the client, before `npm run build` (client/.env.production):
#
#   VITE_API_URL=
#
# Deliberately EMPTY, not the site URL: the API is same-origin, so requests go to
# relative paths and the bundle carries no hostname at all. The same build then
# works on any domain, and the "SPA deployed still calling localhost:8000" failure
# becomes impossible rather than merely unlikely.

# Web Push. Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is safe to ship to the browser; the private key never leaves the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------- call recordings
#
# Where the audio of a logged call is stored. Recordings used to be `bytea` columns in
# Postgres, which stores them perfectly well — the cost is everything downstream:
# `pg_dump` reads every byte, so the nightly backup grows with call volume rather than
# with business data, and a restore has to write them all back before the application
# can start.
#
# THIS DIRECTORY MUST BE ON PERSISTENT STORAGE. In a container with no mounted volume it
# is the container's own filesystem and every recording disappears on the next restart.
# The server probes it at boot by writing a file, logs loudly if it cannot, and falls
# back to storing new recordings in the database — slower, but never silently lost.
#
# Rows written before this keep their bytes in the database and are still served from
# there. Move them across deliberately, when somebody is watching:
#
#   node scripts/migrate-recordings.cjs --dry-run
#   node scripts/migrate-recordings.cjs
#
RECORDING_STORAGE_DIR=./storage/recordings
# Set to `database` to opt out of disk storage entirely.
RECORDING_STORAGE=disk

# ----------------------------------------------------------------- AI features
#
# THREE features in this application send personal information to a third-party AI provider.
# Each has its own switch and each is OFF unless set to `on`. A provider API key governs whether
# a feature CAN run; these govern whether it MAY. See docs/AI-PRIVACY-REVIEW.md for what each one
# discloses, and src/common/ai-consent.ts for the catalogue the switches read.
#
# They used to enable themselves the moment any key appeared in the environment — including a key
# set for an unrelated feature, since the provider layer accepts whichever of ANTHROPIC_API_KEY /
# OPENAI_API_KEY / GEMINI_API_KEY is present. Configuring one silently enabled the others, and
# nothing recorded that client information had gone anywhere.

# "Draft with AI" on a lead. Sends the lead's FIRST NAME, the agent's name and email, and the
# instruction the agent typed. Not the lead's email, phone, budget or property details.
AI_EMAIL_DRAFTING=

# "Suggest follow-ups" on a calendar appointment. Sends the whole appointment record — including
# attendees and any notes the agent wrote — plus the linked lead's name and the linked deal's
# address. Free text an agent typed about a client goes with it.
AI_CALENDAR_SUGGESTIONS=

# FINTRAC Form 630 identity extraction. Sends the COMPLETE IMAGE OR PDF of a passport or driver's
# licence to the provider. The most sensitive disclosure this application makes.
#
# NOT YET WIRED to this switch — see BACKLOG B-3. Setting it does nothing today.
AI_ID_EXTRACTION=

# The setting that controls whether it actually runs lives with the other ID-extraction settings
# further up this file — see the ID_EXTRACTION_PROVIDER block.

# Which provider receives all of the above. Left unset, the first configured key wins in the order
# Anthropic -> OpenAI -> Gemini — so adding a key for one purpose can change who receives data for
# another. Pin it in production so the recipient is a decision rather than an ordering accident.
AI_EMAIL_PROVIDER=

# ---------------------------------------------------------------- Meta lead ads
#
# META_PUBLIC_URL is the address Meta redirects the OAuth callback to AND the host it delivers lead
# webhooks to. Both break the moment it stops resolving, and both break SILENTLY — nobody can
# connect, and leads simply stop arriving.
#
# DO NOT USE A QUICK TUNNEL IN PRODUCTION. trycloudflare/ngrok hand out a NEW hostname on every
# restart, so a value that worked yesterday is dead today. Production config validation now refuses
# to boot on one, alongside a non-HTTPS or localhost value.
META_PUBLIC_URL=

# How long any single Graph request may take before it is abandoned. Without a deadline one hung
# socket held the scheduler's "running" flag for ever and automatic lead sync stopped for every
# connected account until the API was restarted, with nothing logged.
META_GRAPH_TIMEOUT_MS=30000

# Ceiling on how many leads one sync pulls per form. The importer follows Meta's cursor up to this
# number and REPORTS when it stops early, so a backlog is visible rather than silently discarded —
# it used to read only the first page and never mention the rest.
META_MAX_LEADS_PER_FORM=5000

# How long a connected lead form may go without a webhook delivery before the Meta screen says so.
# A webhook stops silently — a lapsed subscription, a redeployed host, an expired tunnel — and the
# only symptom is leads that never appear, which looks exactly like a quiet week. Scheduled polling
# still collects them, so this is a warning rather than an alarm.
META_WEBHOOK_QUIET_HOURS=24

# Cap on the raw Graph payload stored per lead. `meta_raw` exists so an import can be re-examined
# when a form's questions change; it duplicates the mapped columns, so one runaway submission
# should not carry an unbounded row. Truncation is marked in the stored value, never silent.
META_RAW_MAX_CHARS=20000

# How long that raw payload is kept before it is cleared from the lead. It holds everything a person
# typed into an ad — the fullest personal-data footprint this module stores — so keeping it for ever
# with no policy is the part that would be hard to defend. The lead itself is untouched.
# Set to 0 to keep payloads indefinitely.
META_RAW_RETENTION_DAYS=90

# Manual "Sync Now" on the Meta screen, per user. Its own bucket because it is the one endpoint whose
# cost is charged somewhere else: each call fans out to one Graph request per connected lead form, and
# Graph's limits are per APP — so one person holding down Sync spends a budget every other agent in the
# brokerage draws from, and the failures land on them. Six a minute is one every ten seconds, against a
# scheduler that already polls every fifteen.
META_SYNC_RATE_LIMIT_MAX=6
META_SYNC_RATE_LIMIT_WINDOW_SECONDS=60

# The Graph budget the whole brokerage shares. META_SYNC_RATE_LIMIT_MAX above bounds ONE person;
# Meta enforces its limits per APP, so twenty agents each within their own allowance still add up and
# every agent then sees failures none of them caused. One unit is one lead form a sync will read.
# 600 an hour is generous against normal use — a brokerage with forty connected forms spends 160 an
# hour on scheduled polling alone — while still stopping a room full of agents pressing Sync at once.
META_BUDGET_PER_WINDOW=600
META_BUDGET_WINDOW_MINUTES=60

# How often an agent may be emailed that their Meta connection needs reconnecting. A dead token fails
# every scheduled pass, so without this the same alert would arrive 96 times a day and be filtered.
META_RECONNECT_NOTICE_HOURS=24
