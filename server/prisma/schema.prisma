model mail_accounts {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(255)
  from_name       String?           @db.VarChar(255)
  from_email      String            @db.VarChar(255)
  host            String            @db.VarChar(255)
  port            Int               @default(587)
  username        String?           @db.VarChar(255)
  password        String?           @db.Text
  encryption      String?           @db.VarChar(255)
  is_active       Boolean           @default(true)
  is_default      Boolean           @default(false)
  /**
   * Whose account this is. NULL = a brokerage account, managed under admin Email Settings and
   * available as the shared fallback sender. A non-null value is a user's personal account,
   * private to them and used to send their own lead emails and campaigns from their own address.
   */
  user_id         Int?
  /**
   * Which area owns this account: 'crm' or 'desk'. CRM Settings and Transaction Desk
   * Settings each manage their own connections, so an address added on one side never
   * appears on the other.
   * NULL means "not yet assigned" — accounts that pre-date the split. Those still show on
   * both sides so nothing vanished when the column was introduced; assigning one from
   * Settings claims it for that area.
   */
  scope           String?           @db.VarChar(8)
  // ---- IMAP inbound sync (optional; SMTP-only accounts leave these null) ----
  /// IMAP server for pulling received mail, e.g. imap.gmail.com. Null = no inbound sync.
  imap_host       String?           @db.VarChar(255)
  imap_port       Int?
  /**
   * ssl (implicit TLS, usually 993) | tls (STARTTLS) — mirrors the SMTP encryption field.
   */
  imap_encryption String?           @db.VarChar(8)
  /**
   * Whether the poller pulls new mail for this account. This is the real "Auto Sync" switch.
   */
  inbound_enabled Boolean           @default(false)
  /**
   * Highest IMAP UID already fetched, so each poll only pulls what is new.
   */
  last_uid        Int?
  last_synced_at  DateTime?         @db.Timestamp(0)
  /**
   * The last sync error, surfaced in Settings; null when the last sync succeeded.
   */
  sync_error      String?           @db.VarChar(500)
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  email_templates email_templates[]
  inbound_emails  inbound_emails[]
  outbound_emails outbound_emails[]

  @@index([user_id])
}

/**
 * A message pulled from a user's connected mailbox over IMAP.
 * Private to the account's owner and deduped by (account, IMAP UID) so a re-poll never stores a
 * message twice. Matched to a lead by sender address where one exists, the same way an inbound
 * SMS is, so correspondence lands on the lead automatically.
 */
model inbound_emails {
  id           Int           @id @default(autoincrement())
  /**
   * The owner — every inbox query is scoped to this, so no one reads another user's mail.
   */
  user_id      Int
  account_id   Int
  /**
   * IMAP UID within the account's INBOX; unique per account.
   */
  uid          Int
  /**
   * RFC Message-ID, kept for cross-referencing and as a secondary dedupe key.
   */
  message_id   String?       @db.VarChar(512)
  from_email   String?       @db.VarChar(320)
  from_name    String?       @db.VarChar(255)
  to_email     String?       @db.VarChar(320)
  subject      String?       @db.VarChar(998)
  /**
   * A short plain-text preview for the list, so the list query stays light.
   */
  snippet      String?       @db.VarChar(300)
  body_text    String?       @db.Text
  body_html    String?       @db.Text
  received_at  DateTime      @db.Timestamp(0)
  /**
   * Read/unread in our UI, independent of the mailbox's own \Seen flag.
   */
  seen         Boolean       @default(false)
  /**
   * The lead this came from, matched on sender address; null when unmatched.
   */
  lead_id      Int?
  /// Archived out of the active inbox; the message stays in the mailbox. Null = in the Inbox.
  archived_at  DateTime?     @db.Timestamp(0)
  /// Moved to Trash. Null = not deleted. Nullable timestamps rather than a status column: both
  /// questions the screen asks are "when", and a message can be archived and then deleted.
  deleted_at   DateTime?     @db.Timestamp(0)
  /// RFC 5322 threading — the parent's Message-ID and the chain above it.
  in_reply_to       String?  @db.VarChar(512)
  references_header String?  @db.Text
  /// The conversation. First id in References, else In-Reply-To, else this message's own id, so a
  /// whole thread resolves to one key without a recursive lookup.
  thread_key        String?  @db.VarChar(512)
  has_attachments   Boolean  @default(false)
  created_at   DateTime?     @db.Timestamp(0)
  mail_account mail_accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  leads        leads?        @relation(fields: [lead_id], references: [id], onDelete: SetNull, onUpdate: Restrict)
  attachments  inbound_email_attachments[]

  @@unique([account_id, uid])
  @@index([user_id])
  @@index([lead_id])
  /// The inbox list's own index: this user, this account, not archived, not deleted, newest first.
  @@index([user_id, account_id, archived_at, deleted_at, received_at(sort: Desc)], map: "inbound_emails_mailbox_idx")
  @@index([user_id, thread_key], map: "inbound_emails_thread_idx")
  /// The list query: filter by owner (or by the area's primary account) and take the newest 30.
  /// Without these the planner sorts the whole matching set on every page load — measured with
  /// EXPLAIN on 2026-08-05. See migration 20260805200000_inbox_list_index.
  @@index([user_id, received_at(sort: Desc)])
  @@index([account_id, received_at(sort: Desc)])
}

