/// Drafts and sent mail — ONE table, distinguished by `status`, because a draft becomes a sent
/// message in place rather than being copied into a second table at the moment of sending.
model outbound_emails {
  id                Int           @id @default(autoincrement())
  /// The author. Every query is scoped to this; nobody reads or edits another person's drafts.
  user_id           Int
  /// The mailbox it is written from — `mail_accounts.scope` is what keeps CRM and Desk apart.
  account_id        Int
  /// 'draft' | 'sent' | 'failed'. A failed send keeps its content and stays out of Sent.
  status            String        @default("draft") @db.VarChar(16)
  to_emails         String?       @db.Text
  cc_emails         String?       @db.Text
  bcc_emails        String?       @db.Text
  subject           String?       @db.VarChar(998)
  body_html         String?       @db.Text
  body_text         String?       @db.Text
  in_reply_to       String?       @db.VarChar(512)
  references_header String?       @db.Text
  thread_key        String?       @db.VarChar(512)
  message_id        String?       @db.VarChar(512)
  sent_at           DateTime?     @db.Timestamp(0)
  error             String?       @db.VarChar(500)
  created_at        DateTime?     @db.Timestamp(0)
  updated_at        DateTime?     @db.Timestamp(0)
  mail_account      mail_accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  attachments       outbound_email_attachments[]

  @@index([user_id, account_id, status, created_at(sort: Desc)], map: "outbound_emails_mailbox_idx")
  @@index([user_id, thread_key], map: "outbound_emails_thread_idx")
}

