/**
 * Marketing leads — the audience campaigns are sent to.
 * Ported from the Next.js/MongoDB `Lead` model. The segmentation fields drive campaign
 * audience filters; the property_* fields fill the personalisation tokens in a template.
 * `unsubscribed` is the per-lead CASL opt-out (the global list lives in email_suppressions).
 */
model leads {
  id                   Int                   @id @default(autoincrement())
  name                 String                @db.VarChar(255)
  email                String                @db.VarChar(255)
  phone                String?               @db.VarChar(64)
  /**
   * cold | warm | hot | mild
   */
  lead_status          String?               @db.VarChar(32)
  /**
   * Pre construction | resale | seller | buyer | tenant | lease | landlord
   */
  lead_type            String?               @db.VarChar(48)
  /**
   * google ads | meta | refferal | linkedin | youtube
   */
  lead_source          String?               @db.VarChar(48)
  /**
   * Investor | custom buyer | first home buyer | seasonal investor | commercial buyer
   */
  client_type          String?               @db.VarChar(48)
  /**
   * active | inactive | not answering | not actively answering | always responding
   */
  lead_response        String?               @db.VarChar(48)
  /**
   * converted | not-converted
   */
  lead_conversion      String?               @db.VarChar(24)
  /**
   * JSON array of free-form tags.
   */
  tags                 String?               @db.Text
  location             String?               @db.VarChar(255)
  /**
   * Free-text property the lead enquired about.
   */
  property             String?               @db.VarChar(255)
  notes                String?               @db.Text
  // Demographics, used to segment campaigns and to time greeting emails.
  gender               String?               @db.VarChar(24)
  language             String?               @db.VarChar(64)
  religion             String?               @db.VarChar(64)
  age                  Int?
  date_of_birth        DateTime?             @db.Date
  marriage_day         DateTime?             @db.Date
  /**
   * JSON: { budget:{min,max}, propertyType:[], bedrooms, bathrooms, squareFootage, yearBuilt, lotSize, parking, locations:[], features:[] }
   */
  property_preferences String?               @db.Text
  /**
   * users.id of the agent this lead is assigned to.
   */
  assigned_to          Int?
  // ---- provenance ----
  /// manual | import | facebook_meta
  source               String?               @db.VarChar(32)
  /**
   * Meta lead-ad identifiers, used to dedupe on re-sync.
   */
  facebook_lead_id     String?               @unique @db.VarChar(64)
  facebook_form_id     String?               @db.VarChar(64)
  facebook_page_id     String?               @db.VarChar(64)
  /**
   * Free-text answers from a Meta lead form.
   */
  message              String?               @db.Text
  budget               String?               @db.VarChar(128)
  timeline             String?               @db.VarChar(128)
  property_type        String?               @db.VarChar(128)
  /**
   * JSON map of lead-form answers that don't map to a column.
   */
  custom_fields        String?               @db.Text
  // ---- Meta attribution (all nullable; blank for manually created leads) ----
  first_name           String?               @db.VarChar(128)
  last_name            String?               @db.VarChar(128)
  /**
   * Digits-only phone, used for duplicate detection across formats.
   */
  phone_normalized     String?               @db.VarChar(32)
  meta_page_name       String?               @db.VarChar(255)
  meta_form_name       String?               @db.VarChar(255)
  meta_campaign_id     String?               @db.VarChar(64)
  meta_campaign_name   String?               @db.VarChar(255)
  meta_adset_id        String?               @db.VarChar(64)
  meta_adset_name      String?               @db.VarChar(255)
  meta_ad_id           String?               @db.VarChar(64)
  meta_ad_name         String?               @db.VarChar(255)
  /**
   * When Meta recorded the submission, as distinct from when we imported it.
   */
  meta_created_at      DateTime?             @db.Timestamp(0)
  meta_imported_at     DateTime?             @db.Timestamp(0)
  /**
   * The untouched Graph payload, kept for audit and for re-mapping a form later.
   */
  meta_raw             String?               @db.Text
  // Personalisation tokens (PROPERTY_ADDRESS, PROPERTY_PRICE, BEDROOMS, …).
  property_address     String?               @db.VarChar(255)
  property_price       String?               @db.VarChar(64)
  bedrooms             String?               @db.VarChar(16)
  bathrooms            String?               @db.VarChar(16)
  square_footage       String?               @db.VarChar(24)
  key_features         String?               @db.Text
  unsubscribed         Boolean               @default(false)
  unsubscribed_at      DateTime?             @db.Timestamp(0)
  owner_user_id        Int?
  created_by           String?               @db.VarChar(255)
  /**
   * Who moved the lead to the Recently Deleted bin.
   */
  deleted_by           String?               @db.VarChar(255)
  created_at           DateTime?             @db.Timestamp(0)
  updated_at           DateTime?             @db.Timestamp(0)
  deleted_at           DateTime?             @db.Timestamp(0)
  campaign_recipients  campaign_recipients[]
  lead_notes           lead_notes[]
  lead_tasks           lead_tasks[]
  lead_showings        lead_showings[]
  lead_calls           lead_calls[]
  lead_messages        lead_messages[]
  lead_emails          lead_emails[]
  inbound_emails       inbound_emails[]

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

  @@index([email])
  /// UNIQUE PER BOOK — enforced by the database, and NOT expressible here.
  ///
  ///   CREATE UNIQUE INDEX "leads_owner_email_key"
  ///     ON "leads" (COALESCE("owner_user_id", 0), LOWER("email"));
  ///
  /// in migrations/20260808140000_tenant_removal_replacement_constraints, which narrowed the
  /// original three-column form when multi-brokerage tenancy was removed. Prisma has no syntax for
  /// a functional index, so this comment is the only place the schema can record it.
  ///
  /// WHY PER BOOK AND NOT GLOBAL. One person may genuinely be a lead more than once. They click
  /// brokerage A's ad on Monday and brokerage B's on Thursday; they reach agent 1 by referral and
  /// later fill in agent 2's landing page. Each of those is a real, separately-consented
  /// relationship, and a book belongs to its agent. The previous index was global on lower(email),
  /// so the second arrival was silently rejected as a duplicate — a paid click discarded with
  /// nothing on any screen to say so. What must still be refused is the same address twice in the
  /// SAME book, which splits one person's history and double-sends every campaign.
  ///
  /// COALESCE, not a plain three-column unique: Postgres treats NULLs as distinct, and
  /// `owner_user_id IS NULL` is exactly what unattributed brokerage intake looks like — the
  /// highest-volume source there is. Without it, unowned rows would be exempt from the constraint.
  ///
  /// Real behaviour depends on this index existing:
  ///   - `LeadImportEngine` writes with `createMany({ skipDuplicates: true })`, which is
  ///     `ON CONFLICT DO NOTHING` and de-duplicates NOTHING without a unique constraint. Rebuild
  ///     from this schema alone and every re-imported file starts creating duplicates, silently.
  ///   - `LeadsService.create` catches the P2002 it raises and turns it into a validation error;
  ///     without the index the race it guards is simply lost.
  ///
  /// `leads-email-uniqueness.spec.ts` asserts it exists in the connected database and proves both
  /// halves by behaviour, so a schema-only rebuild fails a test rather than production.
  ///
  /// `leads_email_lower_idx` (lower(email)) covers the other question the module asks — "is this
  /// address anywhere in the brokerage?" — which the old global unique index used to answer and
  /// this one cannot.
  @@index([lead_status])
  @@index([lead_source])
  @@index([unsubscribed])
  @@index([assigned_to])
  /// Half of the lead scope filter (assigned_to = me OR owner_user_id = me). Unindexed, the OR
  /// could not use the assigned_to index either and every list read scanned the table.
  @@index([owner_user_id])
  @@index([deleted_at])
  @@index([source])
  @@index([phone_normalized])
  @@index([meta_campaign_id])
}

/**
 * A user's Google Calendar OAuth connection.
 * One per user. Access and refresh tokens are stored AES-256-GCM encrypted (never returned to the
 * browser). The refresh token is the durable credential — Google issues it once, on the first
 * consent with access_type=offline — so it is preserved across re-syncs. `sync_token` powers
 * incremental pulls; `calendar_id` is the calendar being synced ("primary" by default).
 */
model google_connections {
  id               Int       @id @default(autoincrement())
  user_id          Int
  /**
   * Which area this calendar connection belongs to: 'crm' or 'desk'. The two are
   * independent OAuth grants, so connecting a calendar under Transaction Desk Settings
   * does not connect one for the CRM, and vice versa.
   * Connections that pre-date the split are 'crm', because the Google Calendar card
   * originally lived in CRM Settings → Integrations.
   */
  scope            String    @default("crm") @db.VarChar(8)
  google_email     String?   @db.VarChar(320)
  /**
   * enc:v1:… ciphertext.
   */
  access_token     String?   @db.Text
  refresh_token    String?   @db.Text
  token_expires_at DateTime? @db.Timestamp(0)
  scopes           String?   @db.Text
  calendar_id      String    @default("primary") @db.VarChar(255)
  /**
   * Google's incremental sync token, so a pull only fetches what changed.
   */
  sync_token       String?   @db.Text
  last_sync        DateTime? @db.Timestamp(0)
  /**
   * Last connection/sync error, surfaced in Settings; null when healthy.
   */
  connect_error    String?   @db.VarChar(500)
  is_active        Boolean   @default(true)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)

  // One connection per area per user — the pair is what must be unique now that a user can
  // hold a separate CRM and Transaction Desk calendar.
  @@unique([user_id, scope])
  @@index([user_id])
}

/**
 * A read-only Google Calendar subscription by its secret iCal (.ics) address — the no-OAuth way
 * to connect. One per user. The URL is a private link, so it is a credential; it is fetched
 * server-side (restricted to Google's calendar host) and its events are pulled into the CRM
 * calendar. Read-only by nature: an iCal feed cannot receive pushes, so CRM events are not
 * mirrored back through it.
 */
model ical_feeds {
  id         Int       @id @default(autoincrement())
  user_id    Int       @unique
  /**
   * The secret ICS URL (calendar.google.com/.../basic.ics).
   */
  url        String    @db.Text
  /**
   * Calendar name from the feed (X-WR-CALNAME), for display.
   */
  name       String?   @db.VarChar(255)
  last_sync  DateTime? @db.Timestamp(0)
  sync_error String?   @db.VarChar(500)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  @@index([user_id])
}

// ---------------------------------------------------------------------------
// CRM Settings — migrated from the CRM app and kept deliberately separate from
// Transaction Desk's own settings (`company_settings`, `mail_accounts`,
// `email_templates`), which are untouched. Duplication between the two is
// expected at this stage and will be reconciled later.
// ---------------------------------------------------------------------------

/**
 * Per-user (and global) CRM settings. `user_id = null` is the global/admin scope, matching the
 * CRM's `settings` collection where an admin edits the shared document and each user edits
 * their own. JSON columns mirror the CRM's nested shape exactly so no field is lost.
 */
model crm_settings {
  id             Int       @id @default(autoincrement())
  /**
   * null = the global scope an administrator edits.
   */
  user_id        Int?      @unique
  /**
   * { emailAlerts, smsAlerts, leadNotifications, showingReminders, marketUpdates, documentAlerts }
   */
  notifications  String?   @db.Text
  /**
   * { signature, replyTemplate, autoResponder:{enabled,message}, forwardingAddress }
   */
  email_settings String?   @db.Text
  /**
   * { language, timeZone, currency, dateFormat, theme }
   */
  preferences    String?   @db.Text
  /**
   * { birthdayWishes:{enabled,daysBefore,template}, weddingGreetings, seasonalWishes, promotionalOffers, referralCodes }
   */
  templates      String?   @db.Text
  updated_by     String?   @db.VarChar(255)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  /// This table was the odd one out: its sibling CRM tables carried a users relation and it did
  /// not, so a deleted user left their settings row behind for ever. `Cascade`, because a personal
  /// settings row has no meaning without the person — the shared row (user_id NULL) is unaffected,
  /// and `crm_settings_single_global_key` allows only one of those.
  user    users?           @relation(fields: [user_id], references: [id], onDelete: Cascade)

}

/**
 * The CRM's global `emailSettings` document: SMTP details, the auto-send flag and trigger toggles.
 */
model crm_email_settings {
  id                Int       @id @default(autoincrement())
  smtp_host         String?   @db.VarChar(255)
  smtp_port         String?   @db.VarChar(16)
  smtp_user         String?   @db.VarChar(255)
  admin_email       String?   @db.VarChar(255)
  auto_send_enabled Boolean   @default(true)
  /**
   * { birthday, anniversary, wedding, seasonal, promotional, referral, custom }
   */
  template_toggles  String?   @db.Text
  updated_by        String?   @db.VarChar(255)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

  // Declared so `migrate diff` stays empty: this index EXISTS in the database, created by a
  // migration. An index the schema does not mention is one `migrate dev` offers to drop.
}

/**
 * ONE PERSON'S CRM email triggers.
 * Triggers used to be a single brokerage-wide row, so an agent switching off promotional email
 * switched it off for everybody — and the Triggers screen, which shows only switches, wrote the
 * shared SMTP fields back with them. Both problems disappear when the switches belong to the person
 * making them: this table holds nothing but the toggles, and each row is one user's own.
 * A user with no row here inherits `crm_email_settings.template_toggles`, which is the brokerage
 * default an administrator sets under CRM Settings. So a new agent starts with the brokerage's
 * choices and departs from them only where they say so — and only for themselves.
 * The brokerage-wide `auto_send_enabled` still applies over the top: it is the kill switch, not a
 * default, and no personal choice overrides it.
 */
model crm_trigger_settings {
  id               Int       @id @default(autoincrement())
  /// Whose triggers these are. One row per person; deleting the person removes it.
  user_id          Int       @unique
  /**
   * { wedding, seasonal, promotional, referral, custom } — only the keys this person has an
   * opinion about. A key that is absent falls through to the brokerage default.
   */
  template_toggles String?   @db.Text
  updated_by       String?   @db.VarChar(255)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.
  user       users            @relation(fields: [user_id], references: [id], onDelete: Cascade)

}

/**
 * Referral codes generated from CRM Settings.
 */
model crm_referral_codes {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(32)
  discount    Int       @default(10)
  valid_until DateTime  @db.Timestamp(0)
  usage_count Int       @default(0)
  max_usage   Int       @default(5)
  created_by  String?   @db.VarChar(255)
  created_at  DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

}

/**
 * Every advanced/bulk CRM email attempt, so a send can be audited after the fact.
 */
model crm_email_log {
  id         Int       @id @default(autoincrement())
  /**
   * wedding | seasonal | promotional | referral | custom
   */
  kind       String    @db.VarChar(32)
  lead_name  String?   @db.VarChar(255)
  recipient  String    @db.VarChar(255)
  subject    String?   @db.VarChar(500)
  success    Boolean   @default(false)
  error      String?   @db.Text
  /**
   * Set when MAIL_REDIRECT_TO diverted the message away from the real recipient.
   */
  redirected String?   @db.VarChar(255)
  sent_by    String?   @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

  @@index([kind])
  @@index([created_at])
  /// The dedupe lookup the greeting and welcome sweeps make: kind + lower(recipient) + created_at.
  /// Declared here so `migrate diff` stays empty; the index itself is an EXPRESSION index on
  /// `lower(recipient)`, which Prisma cannot express, so it is created by
  /// 20260816140000_crm_email_log_recipient_idx and this line only records that it exists.
  /// Do not "tidy" it away — an index the schema does not mention is one `migrate dev` offers to drop.
}

/**
 * Broadcast messages sent to all users from CRM Settings → Notifications.
 */
model crm_broadcasts {
  id           Int       @id @default(autoincrement())
  message      String    @db.Text
  /**
   * info | warning | success
   */
  type         String    @default("info") @db.VarChar(16)
  /// How many staff have actually received it so far. Written as delivery progresses.
  recipients   Int       @default(0)
  /// sending | completed | partial | failed. A broadcast is delivered off the request thread, so
  /// the row exists — and says `sending` — before anybody has been emailed.
  status       String    @default("completed") @db.VarChar(16)
  /// How many addresses the send is working through in total, so progress means something.
  attempted    Int       @default(0)
  /// Addresses the mail server refused.
  failed       Int       @default(0)
  /// The first failure, in words the person who sent it can act on.
  error        String?   @db.Text
  /// When the last recipient was dealt with. Null while it is still going out.
  completed_at DateTime? @db.Timestamp(0)
  sent_by      String?   @db.VarChar(255)
  sent_by_id   Int?
  created_at   DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

  @@index([created_at])
}

/**
 * Quick checklist items shown alongside the calendar. Deliberately standalone: a todo is a
 * personal reminder with no time slot, so it is not a calendar_event.
 */
model todos {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar(255)
  description  String?   @db.Text
  /**
   * pending | completed | cancelled
   */
  status       String    @default("pending") @db.VarChar(16)
  /**
   * low | medium | high
   */
  priority     String    @default("medium") @db.VarChar(16)
  due_date     DateTime? @db.Date
  completed_at DateTime? @db.Timestamp(0)
  user_id      Int?
  created_by   String?   @db.VarChar(255)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  /// Bumped on every save — the same optimistic-locking token calendar events carry.
  version      Int       @default(1)
  deleted_at   DateTime? @db.Timestamp(0)
  domain       String?   @db.VarChar(8)

  @@index([status])
  @@index([user_id])
  @@index([due_date])
  @@index([deleted_at])
  @@index([domain])
}

/**
 * A user's Facebook/Meta connection. `access_token` is a long-lived user token — encrypted at
 * rest with APP_KEY (see meta-crypto.ts), never returned to the browser.
 */
model meta_connections {
  id                    Int          @id @default(autoincrement())
  user_id               Int          @unique
  access_token          String       @db.Text
  facebook_user_id      String?      @db.VarChar(64)
  facebook_user_name    String?      @db.VarChar(255)
  facebook_user_email   String?      @db.VarChar(255)
  is_active             Boolean      @default(true)
  connected_at          DateTime?    @db.Timestamp(0)
  last_sync             DateTime?    @db.Timestamp(0)
  disconnected_at       DateTime?    @db.Timestamp(0)
  /**
   * When the long-lived token stops working — drives the reconnect warning.
   */
  token_expires_at      DateTime?    @db.Timestamp(0)
  /**
   * When the agent was last told their connection needs reconnecting, so a dead token produces one
   * email rather than one every fifteen minutes for ever.
   */
  reconnect_notified_at DateTime?    @db.Timestamp(0)
  /**
   * Comma-separated permissions Meta actually granted, for the missing-permission notice.
   */
  granted_scopes        String?      @db.Text
  /**
   * Ad account selected for campaign/ad-set/ad attribution, when ads_read was granted.
   */
  ad_account_id         String?      @db.VarChar(64)
  ad_account_name       String?      @db.VarChar(255)
  /**
   * Last Graph failure seen for this connection, surfaced in the UI.
   */
  last_error            String?      @db.Text
  last_error_at         DateTime?    @db.Timestamp(0)
  last_webhook_at       DateTime?    @db.Timestamp(0)
  created_at            DateTime?    @db.Timestamp(0)
  updated_at            DateTime?    @db.Timestamp(0)
  pages                 meta_pages[]

  @@index([is_active])
  @@index([token_expires_at])
}

/**
 * Every webhook delivery Meta makes. The unique `event_key` is what makes processing
 * idempotent: Meta retries aggressively, and a retry must never create a second lead.
 */
model meta_webhook_events {
  id           Int       @id @default(autoincrement())
  /**
   * `${page_id}:${form_id}:${leadgen_id}` — unique per actual submission.
   */
  event_key    String    @unique @db.VarChar(200)
  leadgen_id   String?   @db.VarChar(64)
  form_id      String?   @db.VarChar(64)
  page_id      String?   @db.VarChar(64)
  /**
   * received | processed | duplicate | failed | ignored
   */
  status       String    @default("received") @db.VarChar(16)
  error        String?   @db.Text
  lead_id      Int?
  attempts     Int       @default(1)
  payload      String?   @db.Text
  received_at  DateTime  @db.Timestamp(0)
  processed_at DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

  @@index([status])
  @@index([leadgen_id])
  @@index([received_at])
}

/**
 * One row per sync run — manual, webhook or scheduled — so history is auditable.
 */
model meta_sync_history {
  id          Int       @id @default(autoincrement())
  user_id     Int
  /**
   * manual | webhook | scheduled
   */
  trigger     String    @default("manual") @db.VarChar(16)
  forms_read  Int       @default(0)
  imported    Int       @default(0)
  updated     Int       @default(0)
  skipped     Int       @default(0)
  duplicates  Int       @default(0)
  errors      String?   @db.Text
  started_at  DateTime  @db.Timestamp(0)
  finished_at DateTime? @db.Timestamp(0)

  @@index([user_id])
  @@index([started_at])
}

/**
 * A Facebook Page the connected user administers. Page tokens are encrypted like user tokens.
 */
model meta_pages {
  id            Int              @id @default(autoincrement())
  connection_id Int
  page_id       String           @db.VarChar(64)
  name          String           @db.VarChar(255)
  access_token  String           @db.Text
  created_at    DateTime?        @db.Timestamp(0)
  updated_at    DateTime?        @db.Timestamp(0)
  connection    meta_connections @relation(fields: [connection_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([connection_id, page_id])
  @@index([page_id])
}

/**
 * A lead form the user opted into. Only forms listed here produce leads.
 */
model meta_lead_forms {
  id         Int       @id @default(autoincrement())
  user_id    Int
  form_id    String    @db.VarChar(64)
  page_id    String    @db.VarChar(64)
  form_name  String?   @db.VarChar(255)
  page_name  String?   @db.VarChar(255)
  is_active  Boolean   @default(true)
  last_sync  DateTime? @db.Timestamp(0)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  @@unique([user_id, form_id, page_id])
  /// ONE FORM, ONE AGENT — enforced by `meta_lead_forms_page_form_v2_key`, a partial unique index
  /// on (page_id, form_id) WHERE is_active, created in
  /// migrations/20260808140000_tenant_removal_replacement_constraints. Partial indexes cannot be
  /// expressed in Prisma, so this comment is where the schema records it.
  ///
  /// Each agent connects their own Meta account, their own Page and their own lead forms, and
  /// receives their own leads; nothing is shared. Without the constraint two agents could both
  /// connect the same form, and the webhook resolved the owner with `findFirst` — so one silently
  /// received every lead and the other received none, while their screen showed it as connected.
  ///
  /// Scoped to `is_active` on purpose: a form somebody connected and later turned off must be free
  /// for whoever is running it now.
  @@index([page_id])
  @@index([is_active])
}

/**
 * Timestamped note history on a lead. The source system appended notes into one text
 * blob; separate rows keep each entry's author and time, and make pinning possible.
 */
model lead_notes {
  id         Int       @id @default(autoincrement())
  lead_id    Int
  content    String    @db.Text
  pinned     Boolean   @default(false)
  created_by String?   @db.VarChar(255)
  user_id    Int?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  leads      leads     @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([lead_id])
}

model lead_tasks {
  id          Int       @id @default(autoincrement())
  lead_id     Int
  title       String    @db.VarChar(255)
  due_date    DateTime  @db.Date
  description String?   @db.Text
  /**
   * pending | completed | cancelled
   */
  status      String    @default("pending") @db.VarChar(16)
  /**
   * low | medium | high
   */
  priority    String    @default("medium") @db.VarChar(16)
  assigned_to Int?
  created_by  String?   @db.VarChar(255)
  user_id     Int?
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  leads       leads     @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([lead_id])
  @@index([status])
  @@index([assigned_to])
}

model lead_showings {
  id           Int       @id @default(autoincrement())
  lead_id      Int
  showing_date DateTime  @db.Date
  time         String    @db.VarChar(8)
  property     String?   @db.VarChar(255)
  notes        String?   @db.Text
  /**
   * scheduled | completed | cancelled
   */
  status       String    @default("scheduled") @db.VarChar(16)
  created_by   String?   @db.VarChar(255)
  user_id      Int?
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  leads        leads     @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([lead_id])
  @@index([showing_date])
}

/**
 * Manually logged contact attempts. The source system filled this from Twilio; this app
 * has no telephony, so entries are recorded by the agent after a call.
 */
model lead_calls {
  id           Int                   @id @default(autoincrement())
  lead_id      Int
  called_at    DateTime              @db.Timestamp(0)
  /**
   * Call length in seconds.
   */
  duration     Int?
  /**
   * connected | no answer | voicemail | wrong number | callback requested
   */
  outcome      String?               @db.VarChar(32)
  notes        String?               @db.Text
  created_by   String?               @db.VarChar(255)
  user_id      Int?
  created_at   DateTime?             @db.Timestamp(0)
  /**
   * Twilio Call SID when placed via click-to-call; null for manually logged calls.
   */
  provider_sid String?               @db.VarChar(64)
  /**
   * Live Twilio call status for click-to-call: initiated|ringing|in-progress|completed|no-answer|busy|failed.
   */
  status       String?               @db.VarChar(24)
  leads        leads                 @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  recording    lead_call_recordings?

  @@index([lead_id])
  @@index([provider_sid])
}

/**
 * The audio recording of a logged call, at most one per call.
 * There is no telephony integration, so nothing here is captured automatically — an agent
 * attaches the file their phone or dialler produced. It is a separate table rather than columns
 * on `lead_calls` so that loading a lead never drags the audio along with it; the lead detail
 * selects only the metadata.
 */
model lead_call_recordings {
  id           Int        @id @default(autoincrement())
  /**
   * One recording per call.
   */
  call_id      Int        @unique
  filename     String     @db.VarChar(255)
  /**
   * Always an audio/* type — validated against an allowlist before it is stored.
   */
  content_type String     @db.VarChar(128)
  size         Int
  /**
   * The bytes, for recordings written before they moved to disk.
   * Nullable now, and null on everything created since. Rows that still carry it are served from
   * it — nothing was migrated automatically, because a migration that silently fails to copy a file
   * loses a recording of a client conversation. `scripts/migrate-recordings.cjs` moves them across
   * deliberately, verifying a checksum before it clears the column.
   */
  data         Bytes?
  /**
   * Path under RECORDING_STORAGE_DIR, POSIX-style and relative — e.g. `2026/08/<random>.m4a`.
   * Relative so the storage root can move between environments without rewriting rows. Exactly one
   * of `data` and `storage_path` is set; see RecordingStorageService for why the bytes left the
   * database (backup and restore time, not query performance).
   */
  storage_path String?    @db.VarChar(512)
  created_by   String?    @db.VarChar(255)
  created_at   DateTime?  @db.Timestamp(0)
  call         lead_calls @relation(fields: [call_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  // Declared so `migrate diff` stays empty: this index EXISTS in the database, created by a
  // migration. An index the schema does not mention is one `migrate dev` offers to drop.
  @@index([storage_path])
}

/**
 * A one-off email sent to a lead from their own page, as distinct from a Campaign, which goes to
 * a whole audience and is tracked for opens and unsubscribes. This is a record of correspondence:
 * an agent writing to one person.
 * The row is written only after SMTP accepts the message, so the history never claims something
 * was sent that was not. A failure is recorded too, with the reason, rather than vanishing.
 */
model lead_emails {
  id         Int      @id @default(autoincrement())
  lead_id    Int
  recipient  String   @db.VarChar(255)
  subject    String   @db.VarChar(255)
  body       String   @db.Text
  /**
   * sent | failed
   */
  status     String   @db.VarChar(16)
  /**
   * Why it did not go, when it did not.
   */
  error      String?  @db.VarChar(500)
  /**
   * Which mail_accounts row it went out through, for tracing a delivery problem.
   */
  account_id Int?
  sent_by    String?  @db.VarChar(255)
  user_id    Int?
  sent_at    DateTime @db.Timestamp(0)
  leads      leads    @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([lead_id])
}

/**
 * The SMS conversation with a lead.
 * There is no SMS gateway wired into this app, so nothing here is transmitted by the server.
 * "Send SMS" hands the message to the device's own messaging app through an `sms:` link and
 * records what was sent; an agent logs a reply the same way. The table therefore holds the
 * conversation history, not a delivery queue — there are deliberately no delivery-status or
 * provider-id columns to imply otherwise.
 */
model lead_messages {
  id            Int       @id @default(autoincrement())
  lead_id       Int
  /**
   * outbound (agent → lead) | inbound (lead → agent, logged by the agent)
   */
  direction     String    @db.VarChar(16)
  /**
   * queued | sent | delivered | read | failed, for outbound messages only; null on an inbound one.
   * Filled automatically from Twilio's status callback when a gateway is connected. Without one
   * it is set by hand and only ever holds what the agent knows. Note that "read" is never
   * reported for plain SMS by any provider — the protocol has no read receipt — so it stays a
   * manual mark even when Twilio is connected.
   */
  status        String?   @db.VarChar(16)
  /**
   * Twilio's Message SID, so a status callback can find the row it belongs to.
   */
  provider_sid  String?   @unique @db.VarChar(64)
  /**
   * Twilio's numeric error code on a failed send (e.g. 21211 = invalid "to" number).
   */
  error_code    String?   @db.VarChar(16)
  /**
   * What went wrong, in words, for the agent looking at a failed message.
   */
  error_message String?   @db.VarChar(255)
  body          String    @db.Text
  /**
   * The number the message was addressed to or came from, as it stood at the time.
   */
  phone         String?   @db.VarChar(64)
  sent_at       DateTime  @db.Timestamp(0)
  created_by    String?   @db.VarChar(255)
  user_id       Int?
  created_at    DateTime? @db.Timestamp(0)
  leads         leads     @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([lead_id])
}

/**
 * Tag registry, so a tag stays selectable in the dropdowns even when no lead carries it
 * yet. The full tag list anywhere is this registry unioned with tags present on leads.
 */
model lead_tags {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(64)
  created_by String?   @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

}

/**
 * An email campaign: a template sent to a resolved lead segment. Subject/content are
 * snapshotted so the record stays accurate even if the template is later edited or deleted.
 */
model campaigns {
  id                Int                   @id @default(autoincrement())
  name              String                @db.VarChar(255)
  template_id       Int?
  template_name     String?               @db.VarChar(255)
  category          String?               @db.VarChar(64)
  subject           String                @db.VarChar(500)
  content           String                @db.Text
  /**
   * JSON snapshot of the audience filter this campaign targeted.
   */
  audience          String?               @db.Text
  /**
   * JSON array of labels on the campaign itself.
   */
  tags              String?               @db.Text
  /**
   * draft | sending | completed | failed
   */
  status            String                @default("draft") @db.VarChar(16)
  total             Int                   @default(0)
  sent              Int                   @default(0)
  failed            Int                   @default(0)
  opened            Int                   @default(0)
  /// Distinct recipients who clicked at least one link.
  clicked           Int                   @default(0)
  unsubscribed      Int                   @default(0)
  bounced           Int                   @default(0)
  /// Where this campaign's tracking links point. Persisted so a resumed send builds the same
  /// URLs as the messages already delivered.
  tracking_base_url String?               @db.VarChar(500)
  created_by        String?               @db.VarChar(255)
  created_by_id     Int?
  /**
   * When this campaign should go out, or null for send-now.
   * An absolute instant, always stored UTC. A local wall-clock string would drift by an hour
   * across the two DST transitions the brokerage sits through every year.
   */
  scheduled_for     DateTime?             @db.Timestamp(3)
  sent_at           DateTime?             @db.Timestamp(0)
  created_at        DateTime?             @db.Timestamp(0)
  updated_at        DateTime?             @db.Timestamp(0)
  recipients        campaign_recipients[]

  /**
   * The client's handle for ONE commit, so a repeated request cannot become a second campaign.
   *
   * WHY THIS EXISTS. Sending is fan-out and irreversible: a duplicate campaign is not an untidy row,
   * it is every recipient receiving the same message twice. Nothing stopped that but the builder's
   * `disabled={sending}` attribute — measured by removing it, which produced two scheduled campaigns
   * of eighteen recipients each — and a disabled button is defeated by a network retry, a replayed
   * request, a second tab or a direct API call.
   *
   * SCOPED TO THE CREATOR, NOT GLOBALLY UNIQUE. The key is generated by the client, so a globally
   * unique one would let anybody replay a key they guessed or observed and be handed back somebody
   * else's campaign — turning a de-duplication feature into a disclosure. Uniqueness is therefore on
   * `(created_by_id, idempotency_key)`, and a replay is only ever answered to the account that made
   * the original.
   *
   * NULLABLE, because every campaign created before this existed has no key, and because a caller
   * that sends none is simply not de-duplicated — the previous behaviour, unchanged.
   */
  idempotency_key   String?               @db.VarChar(64)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.
  campaign_links  campaign_links[]
  campaign_clicks campaign_clicks[]

  @@unique([created_by_id, idempotency_key], map: "campaigns_creator_idempotency_key")
  @@index([status])
  @@index([created_at])
  // Declared so `migrate diff` stays empty: this index EXISTS in the database, created by a
  // migration. An index the schema does not mention is one `migrate dev` offers to drop.
  @@index([scheduled_for])
}

/**
 * Marketing / physical-asset inventory (signboards, lock boxes, banners, ...).
 * Distinct from the property-listing "Inventory" screen. `assignments` is the authoritative
 * per-person breakdown ({assignedTo, qty, assignedDate, returnedDate}); the flat assigned_*
 * columns mirror it for legacy readers. Status/balance are derived, never trusted from storage.
 */
model marketing_inventory {
  id            Int       @id @default(autoincrement())
  as_on_date    String?   @db.VarChar(10)
  type          String    @db.VarChar(64)
  custom_type   String?   @db.VarChar(191)
  count         Int       @default(0)
  /**
   * JSON array of {assignedTo, qty, assignedDate, returnedDate}.
   */
  assignments   Json?     @db.JsonB
  assigned_qty  Int       @default(0)
  assigned_to   String?   @db.VarChar(255)
  assigned_date String?   @db.VarChar(10)
  returned_date String?   @db.VarChar(10)
  status        String    @default("Available") @db.VarChar(16)
  remarks       String?   @db.Text
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  /**
   * Soft-delete marker — deleted rows are hidden from the live list, restorable from the bin.
   */
  deleted_at    DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

  @@index([deleted_at])
  @@index([type])
}

/**
 * Per-user MLS favorites. A favorite is an MLS listing key plus a small JSON snapshot of the
 * listing (address/price/beds/…) so the Favorites page renders without re-hitting the MLS feed.
 * Private to whoever saved it; unique per (user, listing).
 */
model favorites {
  id          Int       @id @default(autoincrement())
  user_id     Int
  listing_key String    @db.VarChar(128)
  snapshot    Json?     @db.JsonB
  notes       String?   @db.Text
  created_at  DateTime? @db.Timestamp(0)

  @@unique([user_id, listing_key])
  @@index([user_id])
}

/**
 * One row per person a campaign was sent to, carrying its own engagement state.
 */
/**
 * Marketing email templates owned by the Campaigns module.
 * Deliberately separate from `email_templates`, which drives transactional mail from Email
 * Settings and is keyed by `event_key`. A campaign template is free-form content an agent
 * writes and reuses; the two must not share a table or editing one would change the other.
 */
model campaign_templates {
  id          Int                             @id @default(autoincrement())
  name        String                          @db.VarChar(255)
  subject     String                          @db.VarChar(500)
  content     String                          @db.Text
  /**
   * welcome | follow-up | showing | property-update | thank-you | custom
   */
  category    String                          @default("custom") @db.VarChar(32)
  is_active   Boolean                         @default(true)
  created_by  String?                         @db.VarChar(255)
  user_id     Int?
  created_at  DateTime?                       @db.Timestamp(0)
  updated_at  DateTime?                       @db.Timestamp(0)
  deleted_at  DateTime?                       @db.Timestamp(0)
  attachments campaign_template_attachments[]

  @@index([category])
  @@index([deleted_at])
}

/**
 * A file that rides along with every send of its template.
 */
model campaign_template_attachments {
  id           Int                @id @default(autoincrement())
  template_id  Int
  filename     String             @db.VarChar(255)
  content_type String             @db.VarChar(128)
  size         Int
  data         Bytes
  created_at   DateTime?          @db.Timestamp(0)
  template     campaign_templates @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([template_id])
}

model campaign_recipients {
  id              Int               @id @default(autoincrement())
  campaign_id     Int
  lead_id         Int?
  name            String?           @db.VarChar(255)
  email           String            @db.VarChar(255)
  /**
   * Unguessable per-recipient token embedded in the open pixel and unsubscribe link.
   */
  token           String            @unique @db.VarChar(64)
  /**
   * pending | sent | failed
   */
  /// Resolved personalisation values, as JSON — kept so a resumed send addresses the remaining
  /// recipients exactly as the first half were addressed, even if the lead has changed since.
  vars            String?           @db.Text
  /// When this recipient first clicked any link. Null means they never did.
  /// Timestamp(3), matching the column the migration created. Timestamp(0) ROUNDS rather than
  /// truncating in Postgres, so declaring it here would have had `migrate dev` rewrite the column
  /// and move recorded click times by up to half a second.
  clicked_at      DateTime?         @db.Timestamp(3)
  status          String            @default("pending") @db.VarChar(16)
  error           String?           @db.Text
  opened          Boolean           @default(false)
  opened_at       DateTime?         @db.Timestamp(0)
  unsubscribed    Boolean           @default(false)
  unsubscribed_at DateTime?         @db.Timestamp(0)
  bounced         Boolean           @default(false)
  /// hard | soft | unknown. A hard bounce means the mailbox is gone and the address is suppressed;
  /// a soft one is a transient refusal that gets retried. `unknown` is a fault at our end (bad
  /// SMTP credentials, no connection) and says nothing about the address.
  bounce_type     String?           @db.VarChar(8)
  /// Delivery attempts made for this recipient. Only a soft bounce increments it.
  retry_count     Int               @default(0)
  /// When a soft-bounced recipient may be attempted again. Null means "as soon as the send
  /// reaches it" — the state every recipient starts in.
  next_retry_at   DateTime?         @db.Timestamp(3)
  created_at      DateTime?         @db.Timestamp(0)
  updated_at      DateTime?         @db.Timestamp(0)
  campaign_clicks campaign_clicks[]
  campaigns       campaigns         @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  leads           leads?            @relation(fields: [lead_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([campaign_id])
  @@index([lead_id])
  @@index([email])
  /// The retry sweep asks "which deferred recipients are due?" once a minute. Without this it
  /// scans every recipient row the brokerage has ever created to answer it.
  @@index([status, next_retry_at])
}

/**
 * Global opt-out list. Any address here is excluded from every future send.
 */
model email_suppressions {
  id          Int       @id @default(autoincrement())
  email       String    @unique @db.VarChar(255)
  /// unsubscribe | hard_bounce. Why this address may no longer be mailed — the question
  /// compliance actually asks, and the difference between a person who opted out and a mailbox
  /// that no longer exists.
  reason      String?   @db.VarChar(64)
  campaign_id Int?
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

}

/**
 * Calendar events — appointments, showings, viewings, open houses, follow-ups and calls.
 * Ported from the Next.js/MongoDB `events` collection onto this stack: the document fields
 * become real columns, the free-form `leadId` becomes a nullable FK to a transaction (this
 * app has transactions, not leads), and rows are scoped per user like the source did.
 * `google_calendar_id` / `last_synced_to_google` mirror the source schema so a future Google
 * Calendar sync has somewhere to record itself; nothing writes them yet.
 */
/// `domain` marks which area an event belongs to — see audit_logs. Events synced from a Google
/// calendar take the domain of the connection that produced them; those that pre-date the split
/// stay NULL and appear in both calendars rather than vanishing from one.
model calendar_events {
  id                        Int                        @id @default(autoincrement())
  title                     String                     @db.VarChar(255)
  date                      DateTime                   @db.Date
  time                      String                     @db.VarChar(8)
  /// Optional end time (HH:MM). Null on every event that pre-dates conflict detection; such an
  /// event is treated as a one-hour block, which is what the Google push has always assumed.
  end_time                  String?                    @db.VarChar(8)
  /// Bumped on every save. An edit must send the version it read, or it is refused as a conflict.
  version                   Int                        @default(1)
  /// The series this belongs to — the id of its first occurrence. Null for a one-off appointment.
  recurrence_id             Int?
  /// The rule, carried only by the first occurrence. daily | weekly | monthly.
  recur_freq                String?                    @db.VarChar(10)
  /// Every N days/weeks/months.
  recur_interval            Int?
  /// The last day an occurrence may fall on.
  recur_until               DateTime?                  @db.Date
  /// Total occurrences including the first, when a count is used instead of an end date.
  recur_count               Int?
  /**
   * viewing | meeting | open-house | follow-up | call | showing | task
   */
  type                      String                     @default("meeting") @db.VarChar(24)
  /**
   * scheduled | completed | cancelled | rescheduled
   */
  status                    String                     @default("scheduled") @db.VarChar(16)
  location                  String?                    @db.VarChar(255)
  description               String?                    @db.Text
  attendees                 String?                    @db.VarChar(255)
  contact_phone             String?                    @db.VarChar(64)
  contact_email             String?                    @db.VarChar(255)
  property_details          String?                    @db.Text
  notes                     String?                    @db.Text
  enable_reminder           Boolean                    @default(false)
  reminder_sent             Boolean                    @default(false)
  transaction_id            Int?
  /**
   * Optional link to a lead — set when the event was raised from the Leads module.
   */
  lead_id                   Int?
  user_id                   Int?
  created_by                String?                    @db.VarChar(255)
  domain                    String?                    @db.VarChar(8)
  google_calendar_id        String?                    @db.VarChar(255)
  last_synced_to_google     DateTime?                  @db.Timestamp(0)
  /// Why the last push to Google failed, or null when there is nothing outstanding. Non-null is the
  /// definition of "this event is owed to Google" — see migration 20260805220000_google_sync_retry.
  google_sync_error         String?                    @db.VarChar(500)
  /// How many times the retry sweep has tried. Capped, so a permanently broken event stops asking.
  google_sync_attempts      Int                        @default(0)
  /// When the sweep may try again. Backs off, so a Google outage is not hammered.
  google_sync_next_retry_at DateTime?                  @db.Timestamp(0)
  created_at                DateTime?                  @db.Timestamp(0)
  updated_at                DateTime?                  @db.Timestamp(0)
  deleted_at                DateTime?                  @db.Timestamp(0)
  /// Set when this event was hidden because its Google connection was disconnected — never by a
  /// person deleting an appointment.
  ///
  /// WHY A SEPARATE COLUMN AND NOT JUST `deleted_at`. Both hide the row, and every calendar query
  /// already filters `deleted_at: null`, which is exactly why the hiding is done that way. But the
  /// two must be told apart on RECONNECT: an event hidden by a disconnect has to come back, and an
  /// event the agent deleted must stay gone. Without this marker the pull would have to either
  /// resurrect everything Google still lists — undoing real deletions whenever the push of that
  /// deletion to Google had failed — or resurrect nothing, leaving a reconnected calendar empty.
  google_disconnected_at    DateTime?                  @db.Timestamp(0)
  transactions              transactions?              @relation(fields: [transaction_id], references: [id], onDelete: SetNull, onUpdate: Restrict)
  reminders                 calendar_event_reminders[]

  /// The recurring series this occurrence belongs to — a self-relation, and a real foreign key in
  /// the database (`calendar_events_recurrence_fk`, ON DELETE SET NULL) that this file did not
  /// declare. Undeclared meant Prisma believed the constraint should not exist, so `migrate dev`
  /// offered to drop it and take the series-to-occurrence integrity with it. Declared here, the two
  /// agree. Deleting a series detaches its occurrences rather than deleting them, which is what
  /// SET NULL already did.
  recurrence  calendar_events?  @relation("calendar_event_recurrence", fields: [recurrence_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "calendar_events_recurrence_fk")
  occurrences calendar_events[] @relation("calendar_event_recurrence")

  @@index([date])
  @@index([user_id])
  /// The month grid asks for one month at a time now, so the list query filters on (user, date)
  /// instead of reading a user's whole history and narrowing it in the browser.
  @@index([user_id, date], map: "calendar_events_user_date_idx")
  @@index([recurrence_id], map: "calendar_events_recurrence_idx")
  @@index([transaction_id])
  @@index([lead_id])
  @@index([status])
  @@index([domain])
}

/**
 * One appointment reminder, sent or attempted.
 * `calendar_events.reminder_sent` is a single boolean and cannot say WHICH reminder it refers to,
 * so a day-before and an hour-before notice for the same appointment would overwrite each other on
 * it. A row per (event, lead time) with a unique index is what makes the sweep idempotent: a second
 * pass inserts nothing, and nobody is emailed twice about the same viewing.
 */
/**
 * A browser that has asked to be told about upcoming appointments.
 * One row per browser, not per person: a phone and a desktop are two subscriptions and a reminder
 * reaches both. The endpoint is issued by the push service and identifies the device; the two keys
 * encrypt the payload so the push service cannot read the appointment it is carrying.
 */
/**
 * Which push notifications a person wants. One row per (user, category), and a row exists only
 * once someone has expressed a preference.
 * ABSENCE MEANS ENABLED. That is deliberate: the alternative — seeding a row per user per
 * category, or defaulting to off — would either need a backfill that silently goes stale as
 * categories are added, or would switch off notifications people already rely on the moment this
 * shipped. Opting out is an explicit act and leaves an explicit row; everything else keeps
 * behaving exactly as it did.
 * Deliberately NOT scoped by area. A subscription carries a scope because a browser asks for one
 * area's reminders, but "I don't want listing-expiry pushes" is a statement about the person, not
 * about which screen they were on when they said it.
 */
model notification_preferences {
  id         Int       @id @default(autoincrement())
  user_id    Int
  /// Category key from NOTIFICATION_CATEGORIES — validated in the service, not by the database,
  /// so adding a category needs no migration.
  category   String    @db.VarChar(64)
  /// 'in_app' | 'email' | 'push' — validated in the service, like `category`, so adding a channel
  /// needs no migration. Defaults to 'push' because every row written before channels existed was
  /// somebody muting a push notification; see migration 20260806160000.
  channel    String    @default("push") @db.VarChar(16)
  enabled    Boolean   @default(true)
  created_at DateTime?
  updated_at DateTime?

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category, channel])
  @@index([user_id])
  @@index([user_id, category])
}

model push_subscriptions {
  id           Int       @id @default(autoincrement())
  user_id      Int
  /// The push service URL. Chrome's run past 200 characters, hence Text.
  endpoint     String    @db.Text
  p256dh       String    @db.VarChar(255)
  auth         String    @db.VarChar(255)
  /// Which area's reminders this browser asked for.
  scope        String?   @db.VarChar(8)
  user_agent   String?   @db.VarChar(255)
  last_used_at DateTime?
  /// Consecutive failures. Dropped rather than chased for ever once a browser stops answering.
  failures     Int       @default(0)
  created_at   DateTime?
  updated_at   DateTime?

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "push_subscriptions_user_fk")

  @@unique([endpoint], map: "push_subscriptions_endpoint_key")
  @@index([user_id], map: "push_subscriptions_user_idx")
}

model calendar_event_reminders {
  id                Int       @id @default(autoincrement())
  calendar_event_id Int
  /// How far ahead of the appointment this reminder is for, in minutes.
  lead_minutes      Int
  /// Pending | Sent | Failed | Skipped
  delivery_status   String    @default("Pending") @db.VarChar(16)
  attempts          Int       @default(0)
  next_retry_at     DateTime?
  detail            String?   @db.Text
  sent_to           String?   @db.VarChar(255)
  sent_at           DateTime?
  /// When a push notification went out for this reminder, alongside the email.
  pushed_at         DateTime?
  push_count        Int       @default(0)
  created_at        DateTime?
  updated_at        DateTime?

  // `onUpdate: NoAction` is not decoration: the constraint in the database carries no ON UPDATE
  // clause, and Prisma's default is Cascade. Left unstated, the two disagree and `migrate dev`
  // drops and recreates the key.
  calendar_events calendar_events @relation(fields: [calendar_event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "calendar_event_reminders_event_fk")

  @@unique([calendar_event_id, lead_minutes], map: "calendar_event_reminders_event_lead_key")
  // The `map:` names below are the names these indexes ACTUALLY carry in the database, created by
  // the migration that added them. Without them Prisma computes its own default names, decides the
  // database is wrong, and `migrate dev` renames all three — see the note at the top of this file.
  @@index([delivery_status], map: "calendar_event_reminders_status_idx")
  @@index([next_retry_at], map: "calendar_event_reminders_retry_idx")
}

/**
 * Export & Download Centre. One row per bulk export or document download request, processed
 * off the request thread so a large job cannot time out the API. The generated file lives on
 * disk under storage/app/exports and is reachable only through `token` until `expires_at`.
 */
model export_jobs {
  id                Int       @id @default(autoincrement())
  export_id         String    @unique @db.VarChar(64)
  token             String    @unique @db.VarChar(64)
  action_type       String    @db.VarChar(48)
  format            String    @db.VarChar(16)
  status            String    @default("Queued") @db.VarChar(24)
  transaction_count Int       @default(0)
  document_count    Int       @default(0)
  skipped_count     Int       @default(0)
  file_name         String?   @db.VarChar(255)
  file_path         String?   @db.VarChar(255)
  file_size         Int?
  filters           String?   @db.Text
  selection         String?   @db.Text
  /**
   * Hash of (user + action + format + selection) — blocks duplicate concurrent requests.
   */
  request_hash      String?   @db.VarChar(64)
  requested_by      String?   @db.VarChar(255)
  requested_by_id   Int?
  requested_at      DateTime? @db.Timestamp(0)
  started_at        DateTime? @db.Timestamp(0)
  completed_at      DateTime? @db.Timestamp(0)
  expires_at        DateTime? @db.Timestamp(0)
  download_status   String    @default("Not Downloaded") @db.VarChar(24)
  downloaded_at     DateTime? @db.Timestamp(0)
  download_count    Int       @default(0)
  failure_reason    String?   @db.Text
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

  @@index([requested_by_id])
  @@index([status])
  @@index([requested_at])
}

/**
 * One row per bulk-transaction upload. Records what was validated, what was actually
 * imported and what was rejected, so an import can be audited after the fact. `errors`
 * holds the per-row validation report as JSON (row number, field, value, message, fix).
 */
model import_batches {
  id             Int       @id @default(autoincrement())
  batch_id       String    @unique @db.VarChar(64)
  file_name      String?   @db.VarChar(255)
  uploaded_by    String?   @db.VarChar(255)
  uploaded_by_id Int?
  uploaded_at    DateTime? @db.Timestamp(0)
  completed_at   DateTime? @db.Timestamp(0)
  total_rows     Int       @default(0)
  valid_rows     Int       @default(0)
  imported_rows  Int       @default(0)
  failed_rows    Int       @default(0)
  duplicate_rows Int       @default(0)
  warning_rows   Int       @default(0)
  status         String    @default("Validated") @db.VarChar(32)
  errors         String?   @db.Text
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

  @@index([uploaded_at])
}

/**
 * Express session store (connect-pg-simple). Created at runtime by the session middleware;
 * modelled here so it is tracked by migrations instead of showing up as schema drift.
 */
model user_sessions {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

/**
 * Every documentation reminder that was sent (or attempted), one row per document per
 * recipient. Consolidated reminders share a batch_id so a single "all pending documents in
 * this deal" send can be reported either as one action or as its individual documents.
 */
model document_reminders {
  id              Int          @id @default(autoincrement())
  batch_id        String?      @db.VarChar(64)
  transaction_id  Int
  document_id     Int?
  document_name   String?      @db.VarChar(255)
  document_status String?      @db.VarChar(32)
  reminder_type   String       @db.VarChar(32)
  channel         String       @default("email") @db.VarChar(32)
  recipient       String?      @db.VarChar(255)
  recipient_name  String?      @db.VarChar(255)
  sent_by         String?      @db.VarChar(255)
  sent_by_id      Int?
  sent_at         DateTime?    @db.Timestamp(0)
  delivery_status String       @default("Sent") @db.VarChar(32)
  failure_reason  String?      @db.Text
  message         String?      @db.Text
  document_count  Int          @default(1)
  created_at      DateTime?    @db.Timestamp(0)
  updated_at      DateTime?    @db.Timestamp(0)
  transactions    transactions @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([transaction_id])
  @@index([document_id])
  @@index([sent_at])
  @@index([batch_id])
}

model email_templates {
  id              Int                          @id @default(autoincrement())
  event_key       String                       @unique @db.VarChar(255)
  module          String                       @db.VarChar(255)
  name            String                       @db.VarChar(255)
  subject         String                       @db.VarChar(255)
  body_html       String                       @db.Text
  mail_account_id Int?
  is_active       Boolean                      @default(true)
  created_at      DateTime?                    @db.Timestamp(0)
  updated_at      DateTime?                    @db.Timestamp(0)
  mail_accounts   mail_accounts?               @relation(fields: [mail_account_id], references: [id], onUpdate: Restrict)
  attachments     email_template_attachments[]

  @@index([mail_account_id])
}

/// Files that ride along with every send of an email template. Same shape as
/// campaign_template_attachments — stored in the row rather than on disk, so a template and its
/// files move together in a database backup and nothing can be orphaned by a lost file.
model email_template_attachments {
  id           Int             @id @default(autoincrement())
  template_id  Int
  filename     String          @db.VarChar(255)
  content_type String          @db.VarChar(128)
  size         Int
  data         Bytes
  created_at   DateTime?       @db.Timestamp(0)
  template     email_templates @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([template_id])
}

model failed_jobs {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.Text
  exception  String   @db.Text
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model inter_board_listings {
  id             Int          @id @default(autoincrement())
  transaction_id Int
  name           String?      @db.VarChar(255)
  board_id       String?      @db.VarChar(255)
  verified       Boolean      @default(false)
  position       Int          @default(0)
  created_at     DateTime?    @db.Timestamp(0)
  updated_at     DateTime?    @db.Timestamp(0)
  transactions   transactions @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([transaction_id])
}

model invoice_line_items {
  id          Int       @id @default(autoincrement())
  invoice_id  Int
  row_no      Int       @default(1)
  description String    @db.VarChar(255)
  qty         Decimal   @default(1.00) @db.Decimal(12, 2)
  rate        Decimal   @default(0.00) @db.Decimal(15, 2)
  amount      Decimal   @default(0.00) @db.Decimal(15, 2)
  is_taxable  Boolean   @default(true)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  invoices    invoices  @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([invoice_id])
}

model invoice_payments {
  id         Int       @id @default(autoincrement())
  invoice_id Int
  paid_on    DateTime  @db.Date
  amount     Decimal   @db.Decimal(15, 2)
  method     String?   @db.VarChar(255)
  reference  String?   @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  invoices   invoices  @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([invoice_id])
}

model invoices {
  id                       Int                  @id @default(autoincrement())
  invoice_no               String               @unique @db.VarChar(255)
  transaction_id           Int?
  source                   String               @default("manual") @db.VarChar(20)
  transaction_type         String?              @db.VarChar(255)
  term_no                  Int?
  created_by               Int?
  property_reference       String?              @db.VarChar(255)
  customer_id              Int?
  customer_name            String?              @db.VarChar(255)
  customer_phone           String?              @db.VarChar(255)
  customer_email           String?              @db.VarChar(255)
  customer_address         String?              @db.VarChar(255)
  customer_city            String?              @db.VarChar(255)
  customer_province        String?              @db.VarChar(255)
  customer_postal_code     String?              @db.VarChar(255)
  customer_country         String               @default("Canada") @db.VarChar(255)
  invoice_date             DateTime             @db.Date
  terms                    String               @default("Due on Receipt") @db.VarChar(255)
  due_date                 DateTime?            @db.Date
  trade_number             String?              @db.VarChar(255)
  listing_agent            String?              @db.VarChar(255)
  coop_salesperson         String?              @db.VarChar(255)
  subject                  String?              @db.Text
  status                   String               @default("Draft") @db.VarChar(255)
  delete_reason            String?              @db.VarChar(1000)
  sent_at                  DateTime?            @db.Timestamp(0)
  sub_total                Decimal              @default(0.00) @db.Decimal(15, 2)
  tax_total                Decimal              @default(0.00) @db.Decimal(15, 2)
  total                    Decimal              @default(0.00) @db.Decimal(15, 2)
