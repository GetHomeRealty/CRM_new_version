  mls_num                     String?                       @db.VarChar(255)
  mls_verified                Boolean                       @default(false)
  comm_type                   String                        @default("%") @db.VarChar(255)
  comm_value                  Decimal                       @default(0.00) @db.Decimal(15, 2)
  comm_pct                    Decimal?                      @db.Decimal(8, 4)
  comm_amt                    Decimal?                      @db.Decimal(15, 2)
  comm_adjust_enabled         Boolean                       @default(false)
  comm_adjust_before          Decimal                       @default(0.00) @db.Decimal(15, 2)
  comm_adjust_after           Decimal                       @default(0.00) @db.Decimal(15, 2)
  listing_comm_pct            Decimal?                      @db.Decimal(8, 4)
  coop_comm_pct               Decimal?                      @db.Decimal(8, 4)
  listing_comm_flat           Decimal?                      @db.Decimal(15, 2)
  coop_comm_flat              Decimal?                      @db.Decimal(15, 2)
  trust_payable               Decimal?                      @db.Decimal(15, 2)
  listing_adj_enabled         Boolean                       @default(false)
  listing_adj_before          Decimal                       @default(0.00) @db.Decimal(15, 2)
  listing_adj_after           Decimal                       @default(0.00) @db.Decimal(15, 2)
  coop_adj_enabled            Boolean                       @default(false)
  coop_adj_before             Decimal                       @default(0.00) @db.Decimal(15, 2)
  coop_adj_after              Decimal                       @default(0.00) @db.Decimal(15, 2)
  precon_listing_type         String                        @default("mls") @db.VarChar(255)
  precon_term_count           Int?
  commission_agent            String?                       @db.VarChar(255)
  precon_net_of_hst           Boolean                       @default(false)
  precon_comm_pct             Decimal?                      @db.Decimal(8, 4)
  precon_comm_amt_manual      Decimal?                      @db.Decimal(15, 2)
  precon_details_of_terms     String                        @default("Entire") @db.VarChar(255)
  builder_name                String?                       @db.VarChar(255)
  builder_vendor              String?                       @db.VarChar(255)
  builder_project             String?                       @db.VarChar(255)
  builder_address             String?                       @db.VarChar(255)
  builder_office_email        String?                       @db.VarChar(255)
  builder_invoice_email       String?                       @db.VarChar(255)
  builder_phone               String?                       @db.VarChar(255)
  lawyer_name                 String?                       @db.VarChar(255)
  lawyer_email                String?                       @db.VarChar(255)
  lawyer_phone                String?                       @db.VarChar(255)
  lawyer_address              String?                       @db.VarChar(255)
  buyer_lawyer_name           String?                       @db.VarChar(255)
  buyer_lawyer_email          String?                       @db.VarChar(255)
  buyer_lawyer_phone          String?                       @db.VarChar(255)
  buyer_lawyer_address        String?                       @db.VarChar(255)
  seller_lawyer_name          String?                       @db.VarChar(255)
  seller_lawyer_email         String?                       @db.VarChar(255)
  seller_lawyer_phone         String?                       @db.VarChar(255)
  seller_lawyer_address       String?                       @db.VarChar(255)
  admin_activities            String?                       @db.Text
  activity_tracker            String?                       @db.Text
  adjustments                 String?                       @db.Text
  commercial_lease            String?                       @db.Text
  notice_of_sale              String?                       @db.Text
  comm_status                 String                        @default("Pending") @db.VarChar(255)
  comm_paid_status            String?                       @db.VarChar(255)
  valid_status                String                        @default("Pending") @db.VarChar(255)
  conditional_offer           Boolean                       @default(false)
  inter_board_enabled         Boolean                       @default(false)

  /// ---------------------------------------------------------------- derived agent-payment figures
  ///
  /// WHAT THESE ARE. Everything the reports derive from the `admin_activities` TEXT BLOB about what
  /// the deal's agents have actually been paid, recomputed on write and stored here so no read has
  /// to parse JSON.
  ///
  /// WHY. The blob is not queryable and not indexable, so every report that mentions payment state
  /// re-parsed it for every matching deal on every request. Measured at 80,000 deals: Transaction
  /// Payment Status 10.3 s, Sales Statement 4.0 s, and the brokerage totals 4.2 s of which the
  /// dominant term was a sequential scan calling `desk_safe_jsonb` over ~40,000 wide rows — three
  /// times per request, once per commission variant.
  ///
  /// THE BLOB REMAINS AUTHORITATIVE. These are a cache of a pure function of it, never a second
  /// place to record a payment: nothing writes them except the recompute, and
  /// `verify-payment-cache.cjs` recomputes every one of them from the blob and fails on a
  /// difference of a cent. If the two ever disagree, the blob is right and this is stale.
  ///
  /// SCOPED TO THE DEAL'S OWN AGENT NAMES, which is why they depend on `team_members` as well as on
  /// the blob — and why a change to either has to recompute them. See `agentPaymentsPaid`: the names
  /// are a MULTISET, so an agent on a four-term preconstruction deal is counted four times, and
  /// these figures reproduce that rather than correcting it.
  ///
  /// `calc_agent_payment_status` is deliberately NOT here. It also depends on the commission total,
  /// which is not blob-derived and is already computed in SQL — so it stays a CASE over these
  /// columns plus that figure, rather than a stored value with a wider dependency than its neighbours.
  calc_paid_total             Decimal?                      @db.Decimal(15, 2)
  /// The deal's TOTAL agent commission with HST — `agentCommission(breakdown).total`, unscoped.
  ///
  /// Commission-derived rather than blob-derived, which makes its dependency the widest here: it
  /// moves with the price, the commission settings, the members, their splits and the deal type. It
  /// is cached anyway because the payment-status ladder needs it (`agentCommTotal <= 0` decides
  /// "Not Applicable"), and without it that report cannot be answered without running the whole
  /// commission chain — which is the 10 s this exists to remove.
  ///
  /// COMPUTED BY `CommissionService`, NEVER RE-DERIVED IN SQL. There is one commission engine and
  /// this stores its answer; a second implementation in SQL would be a second set of rounding rules
  /// to keep in step with, over money.
  calc_agent_comm_total       Decimal?                      @db.Decimal(15, 2)
  calc_paid_date              DateTime?                     @db.Date
  calc_paid_name_count        Int?
  calc_agent_name_count       Int?
  calc_faq_paid_status        String?                       @db.VarChar(64)
  /// When the four above were last recomputed. A NULL means "never" — the backfill has not reached
  /// this row — which readers must treat as "parse the blob", not as "nothing has been paid".
  calc_at                     DateTime?                     @db.Timestamp(0)

  created_at                  DateTime?                     @db.Timestamp(0)
  updated_at                  DateTime?                     @db.Timestamp(0)
  reco_audit_ready            String?                       @db.VarChar(255)
  reco_audit_remarks          String?                       @db.Text
  trade_sheet_sent_at         DateTime?                     @db.Timestamp(0)
  trade_sheet_data            String?                       @db.Text
  // Reports module (backward-compatible; NULL on all legacy records)
  payment_type                String?                       @db.VarChar(255)
  listing_price               Decimal?                      @db.Decimal(15, 2)
  lead_source                 String?                       @db.VarChar(255)
  lead_assigned_date          DateTime?                     @db.Date
  lead_converted_date         DateTime?                     @db.Date
  review_email_sent_at        DateTime?                     @db.Timestamp(0)
  review_received_at          DateTime?                     @db.Timestamp(0)
  gift_coupon_value           Decimal?                      @db.Decimal(15, 2)
  gift_coupon_issued_at       DateTime?                     @db.Date
  deleted_at                  DateTime?                     @db.Timestamp(0)
  audit_logs                  audit_logs[]
  brokerages                  brokerages?
  calendar_events             calendar_events[]
  client_identifications      client_identifications[]
  clients                     clients[]
  conditions                  conditions[]
  document_reminders          document_reminders[]
  documents                   documents[]
  inter_board_listings        inter_board_listings[]
  invoices                    invoices[]
  precon_terms                precon_terms[]
  team_members                team_members[]
  transaction_delete_requests transaction_delete_requests[]
  transaction_edit_requests   transaction_edit_requests[]
  transaction_message_reads   transaction_message_reads[]
  transaction_messages        transaction_messages[]
  transaction_reminders       transaction_reminders[]
  transaction_reviews         transaction_reviews[]
  transaction_snapshots       transaction_snapshots[]
  transaction_statuses        transaction_statuses[]
  trashed_row_items           trashed_row_items[]

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

  @@index([agent])
  @@index([type])
  @@index([offer_date])
  @@index([closing_date])
  // The listing-expiry sweep asks for listings expiring in the next few days; without this it
  // reads every transaction in the table every night to find them.
  @@index([listing_expiry_date])
  @@index([payment_type])
  @@index([lead_source])
  // Declared so `migrate diff` stays empty: this index EXISTS in the database, created by a
  // migration. An index the schema does not mention is one `migrate dev` offers to drop.
  @@index([agent_user_id])
  /// Declared so `migrate diff` stays empty: this index EXISTS in the database, created by
  /// migration 20260815090000_desk_commission_sql. The list sorts newest-first over live rows and
  /// had no index for it.
  @@index([deleted_at, created_at(sort: Desc), id(sort: Desc)], map: "transactions_live_recent_idx")
}

model trashed_row_items {
