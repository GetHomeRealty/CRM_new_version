  agent          String?      @db.VarChar(255)
  term           Int?
  label          String?      @db.VarChar(500)
  data           String?      @db.Text
  who            String?      @db.VarChar(255)
  user_id        Int?
  created_at     DateTime?    @db.Timestamp(0)
  updated_at     DateTime?    @db.Timestamp(0)
  transactions   transactions @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([transaction_id])
}

model user_permissions {
  id         Int       @id @default(autoincrement())
  user_id    Int
  screen     String    @db.VarChar(255)
  level      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([user_id, screen])
}

model users {
  id                        Int                         @id @default(autoincrement())
  name                      String                      @db.VarChar(255)
  username                  String?                     @unique @db.VarChar(255)
  email                     String                      @unique @db.VarChar(255)
  role                      String                      @default("agent") @db.VarChar(255)
  /**
   * Added for CRM Settings → Personal Information. Nullable, so nothing existing changes.
   */
  phone                     String?                     @db.VarChar(64)
  status                    String                      @default("Active") @db.VarChar(255)
  /**
   * Where this person sits in the organisation. Free text rather than a lookup: the brokerage has
   * no department or designation list to choose from, and inventing one would be a second thing to
   * maintain for the sake of a label.
   */
  department                String?                     @db.VarChar(120)
  designation               String?                     @db.VarChar(120)
  profile                   String?                     @db.Text
  email_verified_at         DateTime?                   @db.Timestamp(0)
  password                  String                      @db.VarChar(255)
  remember_token            String?                     @db.VarChar(100)
  created_at                DateTime?                   @db.Timestamp(0)
  updated_at                DateTime?                   @db.Timestamp(0)
  transaction_message_reads transaction_message_reads[]
  user_permissions          user_permissions[]
  user_modules              user_modules[]
  sso_authorization_codes   sso_authorization_codes[]

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.
  push_subscriptions       push_subscriptions[]
  notification_preferences notification_preferences[]
  crm_settings             crm_settings[]
  crm_trigger_settings     crm_trigger_settings[]

  notifications           notifications[]
  notification_deliveries notification_deliveries[]
  user_mfa_methods    user_mfa_methods[]
  mfa_recovery_codes  mfa_recovery_codes[]
  mfa_trusted_devices mfa_trusted_devices[]
  mfa_challenges      mfa_challenges[]

  /// CASE-INSENSITIVE UNIQUENESS on `email` and `username` is enforced by two functional indexes
  /// Prisma cannot express here — `users_email_lower_key` and `users_username_lower_key`, added by
  /// migration `20260803000000_users_ci_unique`. The `@unique` attributes above are case-SENSITIVE,
  /// which let `PRIYA@X.CA` and `priya@x.ca` both exist as separate accounts. Do not drop either
  /// index believing `@unique` covers it — `users-validation.spec.ts` fails if they go missing.

}

/// Short-lived, single-use authorization codes issued by the shared CRM sign-in service.
///
/// Only a SHA-256 hash of the code is stored. The raw code exists just long enough to travel
/// through the user's browser to an allowlisted application's callback, where that application's
/// server exchanges it. `code_challenge` binds the exchange to the browser that started it (PKCE),
/// while `consumed_at` makes a captured callback URL useless after its first successful exchange.
///
/// This is authentication infrastructure rather than brokerage data, like `user_sessions`, so it
/// is intentionally not tenant-scoped. The user relation is the authority for account status.
model sso_authorization_codes {
  id             Int       @id @default(autoincrement())
  code_hash      String    @unique @db.VarChar(64)
  user_id        Int
  client_id      String    @db.VarChar(64)
  redirect_uri   String    @db.VarChar(2048)
  code_challenge String    @db.VarChar(128)
  expires_at     DateTime  @db.Timestamp(0)
  consumed_at    DateTime? @db.Timestamp(0)
  created_at     DateTime  @default(now()) @db.Timestamp(0)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([user_id])
  @@index([expires_at])
}

/// Which application modules a user may open.
///
/// One row per user per module. Access is the pair of this and the company's subscription: a module
/// must be both LICENSED to the company and ASSIGNED to the person. Neither alone is enough, and the
/// two are deliberately separate questions — cancelling a subscription should not erase who was
/// assigned what, so that resubscribing restores the previous arrangement rather than a blank slate.
///
/// Every existing user was given both modules by the migration that created this table, so nobody's
/// access changed when it arrived.
model user_modules {
  id          Int       @id @default(autoincrement())
  user_id     Int
  /// 'crm' | 'desk' — the same two words as `mail_accounts.scope` and the domain identifier.
  module_name String    @db.VarChar(16)
  /// 'active' | 'disabled'. A disabled row remembers the assignment without granting it.
  status      String    @default("active") @db.VarChar(16)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  /// One row per user per module — assigning twice is the same fact, not two.
  @@unique([user_id, module_name])
  @@index([module_name])
}

/// What the brokerage has bought — the gate that keeps CRM and Transaction Desk separately
/// licensed.
///
/// EXACTLY ONE ROW, enforced by `subscriptions_singleton_key`, a unique index on the constant
/// expression `(true)`. That replaced a unique on `company_id` when multi-brokerage tenancy was
/// removed: dropping the column would have deleted the constraint rather than narrowing it, and a
/// second row would silently decide module access for everyone, since the licence is read with
/// `findFirst`. Prisma cannot express an expression index, so this comment records it.
model subscriptions {
  id                  Int       @id @default(autoincrement())
  crm_enabled         Boolean   @default(true)
  transaction_enabled Boolean   @default(true)
  plan                String?   @db.VarChar(64)
  expiry_date         DateTime? @db.Date
  /// 'active' | 'expired' | 'suspended'.
  status              String    @default("active") @db.VarChar(16)
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)
}

/// A named role. Seeded from the six roles the application already had.
///
/// `key` is the value stored in `users.role` — unchanged, so no user row was touched. `label` is what
/// the interface shows, and `is_system` marks the roles the application itself depends on, which must
/// not be deleted.
model roles {
  id               Int                @id @default(autoincrement())
  key              String             @db.VarChar(32)
  label            String             @db.VarChar(64)
  is_system        Boolean            @default(false)
  /// A retired role still exists for the rows that reference it, but grants nothing and is not offered.
  is_active        Boolean            @default(true)
  /// Display order, so the roles list does not reorder itself when a row is edited.
  sort             Int                @default(0)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  role_permissions role_permissions[]

  @@unique([key])
}

/// One grantable permission: a screen at a level.
///
/// The application's access model is screen + level (none < view < edit), so a permission is the pair
/// — `lead.view`, `lead.edit`. `none` is not a permission, it is the absence of one. Granting `edit`
/// grants `view` as well, because the levels are ranked; both rows are stored so a query never has to
/// know the ranking.
///
/// `module` groups them for the editor: 'crm', 'desk', or 'core' for what belongs to neither.
model permissions {
  id               Int                @id @default(autoincrement())
  module           String             @db.VarChar(16)
  /// `<screen>.<level>`, e.g. `transactions.edit`.
  permission_name  String             @unique @db.VarChar(64)
  screen           String             @db.VarChar(32)
  level            String             @db.VarChar(8)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  role_permissions role_permissions[]

  @@index([module])
  @@index([screen])
}

/// Which permissions a role grants. Seeded to reproduce the previous defaults exactly.
model role_permissions {
  id            Int         @id @default(autoincrement())
  role_id       Int
  permission_id Int
  created_at    DateTime?   @db.Timestamp(0)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([role_id, permission_id])
  @@index([permission_id])
}

/// A CSV lead import, run in the background rather than inside the request that asked for it.
///
/// Importing was previously done inline: one HTTP request held open while every row was looked up
/// and written one at a time. Measured against 40,000 existing leads, a 5,000-row file spent about
/// 132 seconds in lookups alone — longer than a default reverse-proxy timeout, so the browser saw
/// a 504 over a half-finished import that had no transaction and no way to resume. This row is
/// what makes the work survivable: it owns the progress counters, so a client can poll instead of
/// waiting, and a restart can tell what was in flight.
model lead_import_jobs {
  id     Int     @id @default(autoincrement())
  /// Public identifier. Opaque so a job cannot be guessed from a sequential id.
  job_id String  @unique @db.VarChar(64)
  /// Queued | Processing | Completed | Failed
  status String  @default("Queued") @db.VarChar(24)
  /// Which screen asked — 'campaigns' or 'leads'. They apply the same rules but report differently.
  source String  @default("leads") @db.VarChar(24)
  tag    String? @db.VarChar(190)

  /// The uploaded CSV, held only until the job finishes and then cleared.
  ///
  /// In the row rather than on disk on purpose: it is covered by the same transaction and the same
  /// backup as the job, so there is no orphaned file to reconcile if the process dies mid-import.
  /// Clearing it on completion is what stops this table inheriting the unbounded-growth problem
  /// that `inbound_emails` has.
  payload String? @db.Text

  total_rows     Int @default(0)
  /// Rows consumed so far. Updated once per batch, which is what "2,500 of 5,000" reads from.
  processed_rows Int @default(0)
  imported       Int @default(0)
  tagged         Int @default(0)
  duplicate      Int @default(0)
  invalid        Int @default(0)

  failure_reason  String?   @db.Text
  requested_by    String?   @db.VarChar(255)
  requested_by_id Int?
  requested_at    DateTime? @db.Timestamp(0)
  started_at      DateTime? @db.Timestamp(0)
  completed_at    DateTime? @db.Timestamp(0)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

  @@index([status])
  @@index([requested_by_id])
}

/**
 * A link that appeared in a campaign, recorded at send time.
 * The destination lives here rather than in the tracking URL. Putting it in the query string would
 * make the redirect endpoint an open redirect — anyone could hand out
 * `…/track/click?u=https://evil.example` carrying the brokerage's domain and reputation. The
 * tracking URL therefore names a row id, and the server only ever redirects to a URL it wrote
 * itself.
 */
model campaign_links {
  id          Int       @id @default(autoincrement())
  campaign_id Int
  /// Long by nature — MLS and mapping links carry substantial query strings.
  url         String    @db.Text
  /// Total clicks, including the same person clicking twice.
  clicks      Int       @default(0)
  created_at  DateTime? @db.Timestamp(3)

  campaigns       campaigns         @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  campaign_clicks campaign_clicks[]

  @@index([campaign_id])
}

/**
 * One row per recipient per link, not per click.
 * Kept distinct from `campaign_links.clicks` on purpose: one person clicking the same listing five
 * times is five clicks but one interested party, and reporting the former as engagement overstates
 * how many people are actually in play.
 */
model campaign_clicks {
  id           Int      @id @default(autoincrement())
  campaign_id  Int
  recipient_id Int
  link_id      Int
  clicked_at   DateTime @db.Timestamp(3)

  campaigns           campaigns           @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  campaign_recipients campaign_recipients @relation(fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  campaign_links      campaign_links      @relation(fields: [link_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([recipient_id, link_id], map: "campaign_clicks_recipient_link_key")
  // Declared so `migrate diff` stays empty: this index EXISTS in the database, created by a
  // migration. An index the schema does not mention is one `migrate dev` offers to drop.
  @@index([recipient_id])
  @@index([campaign_id])
}

/// Redeemed OAuth `state` nonces, so a captured callback URL cannot be replayed.
///
/// In the database rather than in memory on purpose. The in-memory Set this replaces was emptied
/// wholesale once it passed 5,000 entries, which made every previously-redeemed nonce replayable
/// again inside its ten-minute window; it was also empty after a restart and not shared between
/// instances. A unique index makes the redeem atomic instead: the insert either wins or it is a
/// replay, with no read-then-write gap for two simultaneous callbacks to slip through.
///
/// Rows are useful only until `expires_at` and are swept opportunistically on redeem.
model meta_oauth_nonces {
  id         Int      @id @default(autoincrement())
  nonce      String   @unique @db.VarChar(64)
  expires_at DateTime @db.Timestamp(0)

  @@index([expires_at])
}

/// Graph calls spent in one time window, shared by everybody.
///
/// Meta enforces its rate limits per APP, not per user, so a per-identity throttle bounds one
/// person and not the brokerage: twenty agents at six manual syncs a minute is still 120 calls a
/// minute against one allowance. This is the counter that makes the ceiling collective.
///
/// One row per window, incremented atomically by an upsert with a conditional update, so two
/// requests arriving together cannot both read "under budget" and both proceed.
model meta_api_budget {
  id           Int    @id @default(autoincrement())
  /// Start of the window, as epoch MILLISECONDS. Deliberately not a timestamp: a
  /// `timestamp without time zone` is written by the raw driver in local time and read back by
  /// Prisma as UTC, so one window resolved to two different rows and the counter never incremented.
  window_start BigInt @unique
  calls        Int    @default(0)

  @@index([window_start])
}

/// ============================================================================================
/// TWO-FACTOR AUTHENTICATION
///
/// Four per-user tables and one brokerage-wide policy table. The per-user ones are reached only
/// through `users` — see src/core/data-ownership.spec.ts, which fails if a new table arrives
/// unclassified. Every read is additionally filtered by `user_id`, which is what bounds them.
///
/// They are read during the login challenge, which happens before the caller is signed in, so none
/// of them may depend on an authenticated session being present.
/// ============================================================================================

/// One row per enrolled factor. A person may hold a TOTP app, an email code and an SMS code at once.
model user_mfa_methods {
  id      Int   @id @default(autoincrement())
  user_id Int
  users   users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  /// 'totp' | 'email' | 'sms'
  type String @db.VarChar(16)

  /// TOTP only: the base32 secret sealed by mfa-crypto (AES-256-GCM). Never returned to the browser
  /// after enrolment is confirmed, and never logged.
  secret String? @db.Text

  /// email/sms only: where the code is sent. Shown to its owner masked.
  destination String? @db.VarChar(255)

  /// Null until the person proves they can produce a code. An unconfirmed row must never satisfy a
  /// challenge — otherwise starting enrolment would be enough to weaken the account rather than
  /// strengthen it.
  confirmed_at DateTime? @db.Timestamp(0)

  /// TOTP replay defence. The last time step accepted for this method; anything at or below it is
  /// refused. RFC 6238 leaves this to the implementer and a code is otherwise reusable for its whole
  /// 90-second window.
  last_step BigInt?

  last_used_at DateTime? @db.Timestamp(0)
  created_at   DateTime  @db.Timestamp(0)
  updated_at   DateTime  @db.Timestamp(0)

  @@unique([user_id, type])
  @@index([user_id])
}

/// Single-use codes for the case the second factor is lost. Stored hashed; shown once, at issue.
model mfa_recovery_codes {
  id      Int   @id @default(autoincrement())
  user_id Int
  users   users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  code_hash  String    @db.VarChar(64)
  used_at    DateTime? @db.Timestamp(0)
  /// How it was spent, for the audit trail — the IP that redeemed it.
  used_ip    String?   @db.VarChar(64)
  created_at DateTime  @db.Timestamp(0)

  @@index([user_id])
  @@index([code_hash])
}

/// "Do not ask again on this device." A hashed random token in a cookie, with an expiry.
model mfa_trusted_devices {
  id      Int   @id @default(autoincrement())
  user_id Int
  users   users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  /// Hashed, not stored raw: the raw value is a bearer credential that skips the second factor, so a
  /// database read must not yield a working one.
  token_hash String @unique @db.VarChar(64)

  label        String?   @db.VarChar(120)
  user_agent   String?   @db.VarChar(255)
  ip           String?   @db.VarChar(64)
  last_seen_at DateTime? @db.Timestamp(0)
  expires_at   DateTime  @db.Timestamp(0)
  revoked_at   DateTime? @db.Timestamp(0)
  created_at   DateTime  @db.Timestamp(0)

  @@index([user_id])
  @@index([expires_at])
}

/// An outstanding email or SMS code. Rows are short-lived and swept once spent or expired.
model mfa_challenges {
  id      Int   @id @default(autoincrement())
  user_id Int
  users   users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  /// 'email' | 'sms'
  method    String @db.VarChar(16)
  code_hash String @db.VarChar(64)

  /// Counted server-side so a code cannot be brute-forced inside its lifetime — six digits is a
  /// million possibilities, which is not many at HTTP speed without a ceiling.
  attempts    Int       @default(0)
  expires_at  DateTime  @db.Timestamp(0)
  consumed_at DateTime? @db.Timestamp(0)
  created_at  DateTime  @db.Timestamp(0)

  @@index([user_id])
  @@index([expires_at])
}

/// Whether a role must hold a second factor, per brokerage. Owned by the brokerage directly.
model mfa_policies {
  id Int @id @default(autoincrement())

  /// The role this applies to, matching `users.role`.
  role     String  @db.VarChar(64)
  required Boolean @default(false)

  /// Days a newly-covered person may sign in before enrolment becomes compulsory. Zero means at
  /// once. Without it, switching the policy on locks out everybody who has not enrolled yet.
  grace_days Int @default(7)

  created_at DateTime @db.Timestamp(0)
  updated_at DateTime @db.Timestamp(0)

  @@unique([role])
}

/// In-app notifications the dispatcher delivers directly.
///
/// The Notification Centre reads this ALONGSIDE the four derived sources (audit logs, reviews,
/// reminders) rather than instead of them — see migration 20260806190000 for why both exist.
model notifications {
  id      Int   @id @default(autoincrement())
  user_id Int
  users   users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  /// A key from NOTIFICATION_CATEGORIES — validated in the service, so a new one needs no migration.
  category String  @db.VarChar(64)
  title    String  @db.VarChar(255)
  body     String? @db.Text
  /// Where "open the related record" goes. Nullable: not everything has a record.
  link     String? @db.VarChar(255)

  /// Idempotency handle, so a retried job cannot leave somebody two copies of one notification.
  dedupe_key String? @db.VarChar(190)

  read_at    DateTime? @db.Timestamp(0)
  created_at DateTime  @db.Timestamp(0)

  @@unique([user_id, dedupe_key])
  @@index([user_id, read_at])
  @@index([user_id, created_at])
}

/// One row per (recipient, category, occurrence, channel): what the dispatcher has already handled.
///
/// WHY THIS EXISTS RATHER THAN READING THE `notifications` ROW. Idempotency used to live on the
/// unique index over `notifications(user_id, dedupe_key)` — which meant it was the IN-APP row that
/// decided whether anything had been sent. Two consequences, and both were real:
///
///   A MUTED CHANNEL DISABLED DEDUPE ENTIRELY. Somebody who turns off in-app and keeps email
///   writes no `notifications` row, so nothing anywhere records that the notification happened.
///   Every later pass believed it was the first.
///
///   EMAIL AND PUSH WERE NEVER DEDUPED AT ALL. Only `sendInApp` consulted the key. A scheduler that
///   legitimately re-selects a row — a follow-up that is still overdue because nobody has done it —
///   re-sent on both of those every pass. At a thirty-minute cadence that is forty-eight emails a
///   day, per task.
///
/// So the record of "this has been dealt with" cannot live on any one channel's own table, and it
/// cannot depend on a preference. It lives here, it is written for EVERY channel including the ones
/// that were muted, and it is written whether or not delivery then succeeded.
///
/// THE UNIQUE INDEX IS THE MECHANISM, not a constraint that happens to be useful: the dispatcher
/// claims a row with ON CONFLICT DO NOTHING before it sends, so two processes racing on the same
/// occurrence cannot both win. `status` then records what became of the attempt.
///
/// `dedupe_key` is the caller's logical occurrence — category plus entity plus occurrence, e.g.
/// `lead-task-due:4182:2026-08-15`. Callers that pass no key are not deduped and write nothing here,
/// which leaves every existing category behaving exactly as it did.
model notification_deliveries {
  id      Int   @id @default(autoincrement())
  user_id Int
  users   users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  /// A key from NOTIFICATION_CATEGORIES. Part of the identity so two categories cannot collide on
  /// one occurrence string — which the `notifications` unique index, lacking it, allows.
  category   String @db.VarChar(64)
  /// The logical occurrence: entity and when. Truncated to 190 by the dispatcher, as before.
  dedupe_key String @db.VarChar(190)
  /// in_app | email | push
  channel    String @db.VarChar(16)

  /// sent | muted | unsupported | failed | no_address | not_configured | duplicate | assumed
  ///
  /// `assumed` is only ever written by the backfill that created this table: it means an in-app
  /// notification row existed for the occurrence, so the dispatch demonstrably ran, but what became
  /// of each individual channel at the time was not recorded anywhere and cannot be reconstructed.
  status String  @db.VarChar(16)
  /// Why, when the status alone does not say — the delivery error, truncated.
  detail String? @db.Text

  created_at DateTime @db.Timestamp(0)
  updated_at DateTime @db.Timestamp(0)

  /// The claim. Also serves the schedulers' "has this occurrence been handled?" lookup as a prefix.
  /// Named explicitly for the same reason as the index below — the migration created it under a
  /// readable name rather than Prisma's generated one, and the two must agree or every `migrate
  /// diff` reports a rename that nobody wants to perform.
  @@unique([user_id, category, dedupe_key, channel], map: "notification_deliveries_identity_key")
  /// `map` because the migration named it `_created_idx` and Prisma's convention is `_created_at_idx`.
  /// Naming it here rather than renaming the index keeps an applied migration's checksum intact.
  @@index([created_at], map: "notification_deliveries_created_idx")
}
