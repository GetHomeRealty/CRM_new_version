/// One decision an administrator made about one agent change, kept for good.
///
/// Every column that describes the change is a SNAPSHOT taken at the moment of the decision —
/// field_label, old_value, new_value, agent_name. The transaction it came from will keep moving
/// afterwards, and a review that re-read the live row would quietly rewrite its own history.
///
/// Rows are never deleted or edited, with one exception: `resolution_status` and the corrected/
/// resolved columns advance as the same issue is put right (Open -> Corrected -> Resolved), which is
/// what turns a pile of disconnected rejections into a lifecycle somebody can follow.
model transaction_reviews {
  id             Int     @id @default(autoincrement())
  transaction_id Int
  /// The audit row this decision was about. Null for a whole-batch "Mark reviewed".
  audit_log_id   Int?
  /// 'Reviewed' or 'Rejected'.
  decision       String  @db.VarChar(16)
  /// Why it was rejected — required on a rejection. Doubles as the optional note on a review.
  reason         String? @db.Text

  // ---- snapshot of the change, as it stood when the decision was made ----
  field_label String? @db.VarChar(255)
  old_value   String? @db.Text
  new_value   String? @db.Text
  /// The agent this decision is ABOUT, as a display name. Snapshot: it records what the deal said
  /// at the time and is never re-resolved. Do not authorize on it — see `agent_user_id`.
  agent_name  String? @db.VarChar(255)
  /// The agent this decision is about, as a USER ID — the authorization key.
  ///
  /// `agent_name` decided who could read a review item, and two active accounts in this brokerage
  /// share a name, so namesakes received each other's rejected fields, reasons and old/new values.
  /// IDs authorize; names display. Null on rows whose owner could not be resolved, which keep the
  /// name fallback exactly as before — see migration 20260814170000_review_agent_user_id.
  agent_user_id Int?
  actor_name  String? @db.VarChar(255)

  /// Whether the old value was put back automatically, and what happened either way.
  auto_reverted      Boolean @default(false)
  auto_revert_result String? @db.VarChar(255)

  /// 'Open', 'Corrected' or 'Resolved'.
  resolution_status String    @default("Open") @db.VarChar(16)
  corrected_at      DateTime? @db.Timestamp(0)
  corrected_by      String?   @db.VarChar(255)
  resolved_at       DateTime? @db.Timestamp(0)
  resolved_by       String?   @db.VarChar(255)

  /// How far the reminder ladder has climbed for this item: 0 none, 1 after a day, 2 after three,
  /// 3 after a week (which also escalates to the office). Stored so a reminder is sent once per
  /// rung rather than every time the sweep runs.
  sla_stage       Int       @default(0)
  sla_notified_at DateTime? @db.Timestamp(0)

  /// When the agent first answered — a reply on the thread, or the correction itself, whichever
  /// came first. Written once and never moved, so "how long before anyone responded" stays a fact
  /// about what happened rather than about the last thing that happened.
  first_response_at DateTime? @db.Timestamp(0)

  /// Set when the agent has seen it, which is what clears their notification.
  agent_seen_at DateTime? @db.Timestamp(0)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)

  transactions transactions                     @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  messages     transaction_review_messages[]
  attachments  transaction_review_attachments[]

  @@index([transaction_id])
  @@index([created_at])
  @@index([resolution_status])
  @@index([transaction_id, resolution_status])
  @@index([agent_user_id])
  // Declared so `migrate diff` stays empty: this index EXISTS in the database, created by a
  // migration. An index the schema does not mention is one `migrate dev` offers to drop.
  @@index([resolution_status, sla_stage])
}

/// One message in the conversation about a single review item.
///
/// Threaded per REVIEW rather than per transaction: the deal's chat is where the team talks about
/// the deal, and "which of these four rejections are you answering?" is a question a flat thread
/// cannot answer. The two coexist — a decision still posts to the deal chat, and the detail is
/// argued out here, against the item it belongs to.
model transaction_review_messages {
  id             Int     @id @default(autoincrement())
  review_id      Int
  transaction_id Int
  user_id        Int?
  author         String? @db.VarChar(255)
  /// The author's role when they wrote it, so a thread still reads correctly after somebody's role
  /// changes or they leave.
  author_role    String? @db.VarChar(32)
  body           String  @db.Text

  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  review      transaction_reviews              @relation(fields: [review_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  attachments transaction_review_attachments[]

  @@index([review_id])
  @@index([transaction_id])
}

/// A file or screenshot attached to a review decision or to one of its messages.
///
/// Held as bytes rather than on disk, like the email template attachments: a review is permanent
/// and its evidence has to be too, so the file travelling with the row in a backup is worth more
/// than the disk space it costs. Exactly one of `review_id` / `message_id` carries the link.
model transaction_review_attachments {
  id           Int     @id @default(autoincrement())
  review_id    Int?
  message_id   Int?
  filename     String  @db.VarChar(255)
  content_type String  @db.VarChar(128)
  size         Int
  data         Bytes
  uploaded_by  String? @db.VarChar(255)

  created_at DateTime? @db.Timestamp(0)

  review  transaction_reviews?         @relation(fields: [review_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  message transaction_review_messages? @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([review_id])
  @@index([message_id])
}

/// One reminder the scheduler sent, tried to send, or decided not to send.
///
/// Doubles as the in-app notification: an `in-app` row that nobody has seen yet IS the bell entry,
/// and opening the transaction stamps `seen_at`. Keeping the two in one table means the history an
/// administrator reads and the badge an agent sees can never disagree about what was sent.
///
/// `scheduled_for` is the DAY the reminder was due, not the moment it went out. That is what makes
/// duplicate protection possible: the unique index below is what stops a scheduler that runs twice,
/// or a retry after a crash, from chasing the same agent twice for the same occurrence.
model transaction_reminders {
  id             Int     @id @default(autoincrement())
  transaction_id Int
  /// 'listing_expiry' | 'lawyer'
  kind           String  @db.VarChar(24)
  /// For lawyer reminders, what was missing when it was sent: 'buyer' | 'seller' | 'both'.
  variant        String? @db.VarChar(16)

  /// The day this occurrence belonged to — the key duplicate protection is built on.
  scheduled_for  DateTime @db.Date
  /// Days between that day and the closing/expiry date it is about.
  days_remaining Int?

  recipient       String? @db.VarChar(255)
  /// 'email' | 'in-app'
  delivery_method String  @db.VarChar(16)
  /// 'Sent' | 'Failed' | 'Skipped'
  delivery_status String  @db.VarChar(16)
  /// Why it failed, or why it was skipped.
  detail          String? @db.Text
  subject         String? @db.VarChar(255)

  /// How many delivery attempts this row has had, and when the next one is due.
  ///
  /// Only ever set on an email row that failed for a TRANSIENT reason. A permanent failure — a
  /// rejected address, a refused password — leaves `next_retry_at` null, because asking a mail
  /// server the same rejected question every hour is how a sender ends up blocklisted.
  attempts        Int       @default(1)
  next_retry_at   DateTime? @db.Timestamp(0)
  last_attempt_at DateTime? @db.Timestamp(0)

  /// Set when the agent opened the transaction, which is what clears the bell entry.
  seen_at    DateTime? @db.Timestamp(0)
  created_at DateTime? @db.Timestamp(0)

  transactions transactions @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  /// One reminder per occurrence per channel. The scheduler relies on this rather than on its own
  /// bookkeeping, so a second run on the same day is harmless by construction.
  @@unique([transaction_id, kind, scheduled_for, delivery_method], map: "transaction_reminders_txn_kind_day_method_key")
  @@index([transaction_id])
  @@index([kind, scheduled_for])
  @@index([recipient, seen_at])
  @@index([next_retry_at])
}

model transaction_snapshots {
  id             Int          @id @default(autoincrement())
