// Transaction Desk — PostgreSQL schema (Prisma).
//
// Ported from the existing Laravel MySQL database (prisma/schema.mysql.prisma,
// produced by `prisma db pull`). Porting rules applied consistently:
//   • MySQL unsigned bigint/int (id/FK/counter) → Postgres Int (serial); the app's
//     magnitudes fit in int4 and ids then serialize as plain JSON numbers, exactly
//     like Laravel (Prisma BigInt → JS BigInt is not JSON-serializable).
//   • text/mediumtext/longtext → Text.
//   • JSON blob columns (Eloquent array/json casts: transactions.financial-related
//     admin_activities/adjustments/activity_tracker, users.profile, documents.files,
//     invoices.reminders/auto_reminder, …) are stored as Text and parsed/encoded in
//     the service layer, preserving Laravel's exact behaviour.
//   • timestamps → Timestamp(0); dates → Date; decimals unchanged.
//
// This is a faithful 1:1 port of every table (incl. Laravel infra tables like
// cache/jobs/migrations, kept harmless for shape parity; the ETL copies domain
// data only).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model agents {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(255)
  email      String?   @db.VarChar(255)
  phone      String?   @db.VarChar(255)
  is_team    Boolean   @default(false)
  active     Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  /// The brokerage this row belongs to. See src/core/tenancy.spec.ts for why this table carries one.

}

/// `domain` marks which area an audit entry belongs to: 'crm', 'desk', or 'common' for the
/// shared modules (Users, Client Reviews, MLS, Inventory). NULL means not yet classified and is
/// shown in both areas, so no historical record is hidden by the separation.
model audit_logs {
  id             Int           @id @default(autoincrement())
  category       String?       @db.VarChar(255)
  domain         String?       @db.VarChar(8)
  transaction_id Int?
  who            String?       @db.VarChar(255)
  user_id        Int?
  section        String?       @db.VarChar(255)
  field          String?       @db.VarChar(255)
  old_value      String?       @db.Text
  new_value      String?       @db.Text
  action         String?       @db.VarChar(255)
  source         String?       @db.VarChar(255)
  handled        Boolean       @default(false)
  details        String?       @db.Text
  /// Where the action came from. Null for background work, which is the honest answer — nobody
  /// pressed anything. Written centrally by AuditService from the request context; see
  /// migration 20260814140000_audit_request_context.
  ip             String?       @db.VarChar(45)
  user_agent     String?       @db.VarChar(255)
  /// The same id the structured log stamps on every line and the API returns in `X-Request-Id`,
  /// so an audit row can be joined to the logs of the request that wrote it.
  request_id     String?       @db.VarChar(64)
  created_at     DateTime?     @db.Timestamp(0)
  updated_at     DateTime?     @db.Timestamp(0)
  transactions   transactions? @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([category])
  @@index([domain])
  /// Serves the audit trail's own page (domain filter + newest-first) and the retention sweep's
  /// candidate count. Measured at 240k rows: 45.0 ms -> 4.7 ms and 46.1 ms -> 0.1 ms.
  /// See migration 20260814210000_audit_domain_created_at_index.
  @@index([domain, created_at(sort: Desc)])
  @@index([transaction_id])
  /// Trigram indexes for the Audit Trail's text search — see migration 20260816120000. Declared
  /// here as well as in the migration so `migrate diff` reports no drift.
  @@index([who(ops: raw("gin_trgm_ops"))], map: "audit_logs_who_trgm_idx", type: Gin)
  @@index([section(ops: raw("gin_trgm_ops"))], map: "audit_logs_section_trgm_idx", type: Gin)
  @@index([field(ops: raw("gin_trgm_ops"))], map: "audit_logs_field_trgm_idx", type: Gin)
  @@index([old_value(ops: raw("gin_trgm_ops"))], map: "audit_logs_old_value_trgm_idx", type: Gin)
  @@index([new_value(ops: raw("gin_trgm_ops"))], map: "audit_logs_new_value_trgm_idx", type: Gin)
  @@index([action(ops: raw("gin_trgm_ops"))], map: "audit_logs_action_trgm_idx", type: Gin)
  @@index([details(ops: raw("gin_trgm_ops"))], map: "audit_logs_details_trgm_idx", type: Gin)
}

model brokerage_agents {
  id           Int        @id @default(autoincrement())
  brokerage_id Int
  name         String     @db.VarChar(255)
  position     Int        @default(0)
  created_at   DateTime?  @db.Timestamp(0)
  updated_at   DateTime?  @db.Timestamp(0)
  brokerages   brokerages @relation(fields: [brokerage_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([brokerage_id])
}

model brokerages {
  id               Int                @id @default(autoincrement())
  transaction_id   Int                @unique
  name             String?            @db.VarChar(255)
  address          String?            @db.VarChar(255)
  email            String?            @db.VarChar(255)
  invoice_email    String?            @db.VarChar(255)
  agent_email      String?            @db.VarChar(255)
  phone            String?            @db.VarChar(255)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  brokerage_agents brokerage_agents[]
  transactions     transactions       @relation(fields: [transaction_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

}

model cache {
  key        String @id @db.VarChar(255)
