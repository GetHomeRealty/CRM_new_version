{
  "name": "transaction-desk-server",
  "version": "0.0.1",
  "description": "Transaction Desk API — NestJS port of the Laravel 12 backend (PostgreSQL + Prisma). Behaviour-preserving.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prebuild": "node scripts/build-guard.cjs --clean",
    "build": "nest build",
    "postbuild": "node scripts/build-guard.cjs --verify",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "node scripts/prisma-guard.cjs --verify && tsc --noEmit -p tsconfig.json",
    "prisma:generate": "node scripts/prisma-guard.cjs --generate",
    "prisma:pull:mysql": "prisma db pull --schema prisma/schema.mysql.prisma",
    "prisma:migrate": "node scripts/guard-migrate-dev.cjs && prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/restore.mjs --verify",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.2.1",
    "@types/archiver": "^8.0.0",
    "@types/nodemailer": "^8.0.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "connect-pg-simple": "^10.0.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "imapflow": "^1.4.9",
    "ioredis": "^5.11.1",
    "mailparser": "^3.9.14",
    "node-ical": "^0.27.1",
    "nodemailer": "^9.0.3",
    "pdfmake": "^0.3.11",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.14",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "jest": "^29.7.0",
    "mysql2": "^3.23.0",
    "prisma": "^6.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "multer": "^2.2.0",
    "lodash": "^4.18.1",
    "brace-expansion": "^5.0.9",
    "qs": "^6.15.3",
    "file-type": "^22.0.1",
    "body-parser": "^1.20.6"
  }
}
