# =============================================================================
# PRODUCTION — environment template (LEGACY Next.js/Vercel app; not myapp)
# Copy to project root:  cp config/env/production.env.example production.env
# Or paste keys into Vercel / your host's dashboard (Production environment).
# =============================================================================
#
# OAuth / webhooks: register these URLs on each provider for THIS domain:
#   .../api/auth/google-calendar/callback
#   .../api/email-integration/gmail/callback
#   .../api/auth/facebook/callback
#   .../api/twilio/incoming-sms  (POST)
#   Twilio inbound voice webhook (gamma app, NOT gethomehub.ca):
#     https://twilio-voice-app-gamma.vercel.app/api/twilio/webhook (POST)
#   Gamma calls CRM for forwarding: https://gethomehub.ca/api/call-forwarding
#   .../api/webhooks/facebook    (GET verify + POST) — if using Meta leads
#
# Cron routes (Vercel Cron, etc.): send header  Authorization: Bearer <CRON_SECRET>
# NEXT_PUBLIC_* variables are exposed to the browser — never put secrets there.
# =============================================================================

# --- Runtime ---
NODE_ENV=production

# --- Public URLs (production: gethomehub.ca) ---
NEXT_PUBLIC_APP_URL=https://gethomehub.ca
NEXT_PUBLIC_BASE_URL=https://gethomehub.ca
NEXT_PUBLIC_APP_TWILIO_URL=https://twilio-voice-app-gamma.vercel.app
NEXTAUTH_URL=https://gethomehub.ca

# Optional: email/PDF logo path (default in code: /assets/logo.webp)
# NEXT_PUBLIC_APP_LOGO_PATH=/assets/logo.webp

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority

# --- Auth & security (generate with: openssl rand -base64 32) ---
JWT_SECRET=<generate-at-least-32-chars>
NEXTAUTH_SECRET=<generate-at-least-32-chars>
CRON_SECRET=<generate-cron-bearer-secret>

# --- Twilio (SMS, voice, browser call token) ---
TWILIO_ACCOUNT_SID=<twilio_account_sid>
TWILIO_AUTH_TOKEN=<twilio_auth_token>
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
NEXT_PUBLIC_TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_API_KEY=<api_key_sid_for_voice>
TWILIO_API_SECRET=<api_key_secret>
TWILIO_TWIML_APP_SID=<twiml_app_sid>
# Twilio Console -> Phone number -> Voice -> "A call comes in":
#   https://twilio-voice-app-gamma.vercel.app/api/twilio/webhook (HTTP POST)

# --- Email (transactional SMTP; code primarily uses SMTP_* + ADMIN_EMAIL) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<smtp_login_email>
SMTP_PASS=<app_password_or_smtp_password>
ADMIN_EMAIL=<admin_inbox@gethomehub.ca>

# Legacy / alternate names (some docs reference these; align with SMTP_* if used)
EMAIL_USER=<smtp_login_email>
EMAIL_PASSWORD=<app_password>

# IMAP (if your deployment uses IMAP features)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Optional: separate mailbox for invoice-only sending (falls back to SMTP_*)
INVOICE_SMTP_USER=<invoice_email_optional>
INVOICE_SMTP_PASS=<invoice_app_password_optional>

# --- Branding in email templates (public) ---
NEXT_PUBLIC_AGENT_EMAIL=info@gethomehub.ca
NEXT_PUBLIC_AGENT_PHONE=+1-555-555-5555
NEXT_PUBLIC_AGENT_NAME=Get Home Realty

# --- AI ---
NEXT_PUBLIC_GEMINI_API_KEY=<gemini_api_key_optional>
OPENAI_API_KEY=<openai_secret_key_optional>
# NEXT_PUBLIC_OPENAI_API_KEY=   # avoid — exposes key to client

# --- Google (OAuth: Calendar, Gmail integration, Maps) ---
GOOGLE_CLIENT_ID=<google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<google_oauth_client_secret>
GOOGLE_REDIRECT_URI=https://gethomehub.ca/api/google-calendar-callback
GOOGLE_GMAIL_REDIRECT_URI=https://gethomehub.ca/api/email-integration/gmail/callback
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<maps_or_places_key_restricted_to_domain>

# --- MLS (AMPRE / TRREB vendor API) ---
MLS_ACCESS_TOKEN=<vendor_bearer_token>
MLS_API_URL=https://query.ampre.ca/odata/Property

# --- Meta / Facebook (optional: Lead Ads, login, webhooks) ---
FACEBOOK_APP_ID=<facebook_app_id>
FACEBOOK_APP_SECRET=<facebook_app_secret>
# Facebook Login for Business -> Configurations (GHR CRM Lead Ads)
FACEBOOK_LOGIN_CONFIG_ID=2238682266928505
FACEBOOK_WEBHOOK_VERIFY_TOKEN=<random_verify_string>
FACEBOOK_WEBHOOK_SECRET=<app_secret_for_x_hub_signature_optional>

# --- Payments (optional; Stripe block commented in code) ---
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# --- Platform (Vercel sets automatically; don't set manually) ---
# VERCEL=1
