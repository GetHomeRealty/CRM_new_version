# =============================================================================
# UAT / STAGING — environment template (LEGACY Next.js/Vercel app; not myapp)
# Copy to project root:  cp config/env/uat.env.example uat.env
# Use a separate MongoDB database (or cluster) from production.
# =============================================================================
# OAuth / webhooks: add THIS UAT host to each provider's allowed redirects.
# Cron: Authorization: Bearer <CRON_SECRET>  (different secret than prod)
# NEXT_PUBLIC_* values are exposed to the browser — no secrets.
# =============================================================================

# --- Runtime ---
NODE_ENV=production

# --- Public URLs (your UAT/staging domain) ---
NEXT_PUBLIC_APP_URL=https://your-uat-domain.com
NEXT_PUBLIC_BASE_URL=https://your-uat-domain.com
NEXT_PUBLIC_APP_TWILIO_URL=https://your-uat-domain.com
NEXTAUTH_URL=https://your-uat-domain.com

# NEXT_PUBLIC_APP_LOGO_PATH=/assets/logo.webp

# --- Database (separate DB name or cluster from production) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>-uat?retryWrites=true&w=majority

# --- Auth & security (do not reuse production secrets) ---
JWT_SECRET=<uat-jwt-secret-openssl-rand-base64-32>
NEXTAUTH_SECRET=<uat-nextauth-secret-openssl-rand-base64-32>
CRON_SECRET=<uat-cron-secret>

# --- Twilio ---
TWILIO_ACCOUNT_SID=<twilio_account_sid>
TWILIO_AUTH_TOKEN=<twilio_auth_token>
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
NEXT_PUBLIC_TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_API_KEY=<twilio_api_key>
TWILIO_API_SECRET=<twilio_api_secret>
TWILIO_TWIML_APP_SID=<twiml_app_sid_for_uat>

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<uat_smtp_user>
SMTP_PASS=<uat_smtp_app_password>
ADMIN_EMAIL=<uat_admin@yourdomain.com>
EMAIL_USER=<uat_smtp_user>
EMAIL_PASSWORD=<uat_smtp_app_password>
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
INVOICE_SMTP_USER=<optional>
INVOICE_SMTP_PASS=<optional>

# --- Branding ---
NEXT_PUBLIC_AGENT_EMAIL=uat-info@yourdomain.com
NEXT_PUBLIC_AGENT_PHONE=+1-555-555-5555
NEXT_PUBLIC_AGENT_NAME=Get Home Realty (UAT)

# --- AI ---
NEXT_PUBLIC_GEMINI_API_KEY=<gemini_key_optional>
OPENAI_API_KEY=<openai_key_optional>

# --- Google ---
GOOGLE_CLIENT_ID=<google_oauth_client_id_uat_or_extra_redirects>
GOOGLE_CLIENT_SECRET=<google_oauth_client_secret>
GOOGLE_REDIRECT_URI=https://your-uat-domain.com/api/auth/google-calendar/callback
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<maps_key>

# --- MLS ---
MLS_ACCESS_TOKEN=<mls_token_sandbox_or_shared>
MLS_API_URL=https://query.ampre.ca/odata/Property

# --- Facebook (optional) ---
FACEBOOK_APP_ID=<facebook_app_id>
FACEBOOK_APP_SECRET=<facebook_app_secret>
FACEBOOK_WEBHOOK_VERIFY_TOKEN=<uat_verify_token>
FACEBOOK_WEBHOOK_SECRET=<optional>

# --- Stripe (optional) ---
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
