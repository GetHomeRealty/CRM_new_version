# Paste into Vercel -> Project -> Settings -> Environment Variables (or copy to gitignored vercel.env).
# LEGACY Next.js/Vercel app template — not myapp. Use Production/Preview/Development scopes as needed.

NODE_ENV=production

NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_TWILIO_URL=https://twilio-voice-app-gamma.vercel.app
NEXTAUTH_URL=https://your-app.vercel.app

MONGODB_URI=mongodb+srv://user:password@cluster/db?retryWrites=true&w=majority
JWT_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
CRON_SECRET=generate_with_openssl_rand_base64_32

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NEXT_PUBLIC_TWILIO_PHONE_NUMBER=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
EMAIL_USER=
EMAIL_PASSWORD=

NEXT_PUBLIC_AGENT_EMAIL=
NEXT_PUBLIC_AGENT_PHONE=
NEXT_PUBLIC_AGENT_NAME=

NEXT_PUBLIC_GEMINI_API_KEY=
OPENAI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google-calendar/callback
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

MLS_ACCESS_TOKEN=
MLS_API_URL=https://query.ampre.ca/odata/Property

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_WEBHOOK_SECRET=

INVOICE_SMTP_USER=
INVOICE_SMTP_PASS=

