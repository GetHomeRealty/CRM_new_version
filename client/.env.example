# Base URL of the Laravel API / backend (scheme + host, no trailing slash).
#
# Local dev (this repo's committed client/.env):
#   VITE_API_URL=http://localhost:8000
#
# Production: create client/.env.production on the server (gitignored) with the
# public API host, then `npm run build`. Vite bakes this value into the bundle.
#   VITE_API_URL=https://transaction.gethomehub.ca
VITE_API_URL=http://localhost:8000
