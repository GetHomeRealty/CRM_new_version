# Public mobile values only. Copy to .env.providers.local (ignored) after obtaining real test values.
# Expo does not auto-load this custom filename: load the approved values explicitly when configuring/building.
# Never put OAuth secrets, SMTP passwords, APP_KEY or EXPO_PUSH_ACCESS_TOKEN here.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_AUTH_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_NATIVE_PUSH_ENABLED=false
EXPO_PUBLIC_META_MANAGEMENT_ENABLED=false
EXPO_PUBLIC_INBOX_REPLY_SENDING_ENABLED=false
EXPO_PUBLIC_CAMPAIGN_SENDING_ENABLED=false
EXPO_PUBLIC_LOCAL_CAMPAIGN_SEND_TESTING=false
EXPO_PUBLIC_LEAD_IMPORT_ENABLED=false
